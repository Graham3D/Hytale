Group {
  Anchor: (Width: 1080, Height: 72);
  LayoutMode: Top;
  Background: #20364c;
  Padding: (Horizontal: 12, Vertical: 6);
  Label #Title { Anchor: (Height: 28); Style: (FontSize: 17, TextColor: #eef6ff); }
  Label #Detail { Anchor: (Height: 30); Style: (FontSize: 13, TextColor: #b4c7d4); }
}
