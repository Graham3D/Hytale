@ProbeGridStyle = ItemGridStyle(
  SlotSpacing: 2,
  SlotSize: 74,
  SlotIconSize: 64,
  SlotBackground: "Assets/Slot.png",
  QuantityPopupSlotOverlay: "Assets/QuantityPopupSlotOverlay.png",
  BrokenSlotBackgroundOverlay: "Assets/SlotItemBrokenCracksOverlay.png",
  BrokenSlotIconOverlay: "Assets/SlotItemBrokenIconOverlay.png",
  DefaultItemIcon: "Assets/UnknownItemIcon.png",
  DurabilityBar: "Assets/DurabilityBar.png",
  DurabilityBarBackground: "Assets/DurabilityBarBackground.png",
  DurabilityBarAnchor: (Bottom: 6, Left: 9, Width: 30, Height: 2),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "Assets/CursedSpiral.png",
  EphemeralIconAnchor: (Bottom: 51, Left: 34, Width: 16, Height: 16)
);

@ProbeGrid = ItemGrid {
  Anchor: (Width: 534, Height: 306);
  SlotsPerRow: 7;
  Style: @ProbeGridStyle;
  Background: #000000(0);
  Padding: 2;
  ShowScrollbar: false;
  AreItemsDraggable: true;
  AllowMaxStackDraggableItems: true;
  DisplayItemQuantity: true;
  RenderItemQualityBackground: true;
  RenderEmptySlots: true;
};
