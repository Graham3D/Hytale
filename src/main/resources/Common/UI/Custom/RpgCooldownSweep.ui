Group #RpgCooldownOverlayRoot {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  // The first two overlays follow the native Ability2/3 cells. The additional
  // overlays follow the visible unbound Hywind assignments.
  // Read-only overlays: no buttons, icons, key bindings, native stat controls or input capture.
  CircularProgressBar #RpgCooldownSkill01 {
    Anchor: (Right: 176, Bottom: 72, Width: 58, Height: 58);
    MaskTexturePath: "Assets/RpgHud/CooldownMask.png";
    Color: #ff0000(0.50);
    Value: 0;
    Visible: false;
  }
  CircularProgressBar #RpgCooldownSkill02 {
    Anchor: (Right: 82, Bottom: 72, Width: 58, Height: 58);
    MaskTexturePath: "Assets/RpgHud/CooldownMask.png";
    Color: #ff0000(0.50);
    Value: 0;
    Visible: false;
  }
  CircularProgressBar #RpgCooldownSkill03 {
    Anchor: (Right: 364, Bottom: 72, Width: 58, Height: 58);
    MaskTexturePath: "Assets/RpgHud/CooldownMask.png";
    Color: #ff0000(0.50); Value: 0; Visible: false;
  }
  CircularProgressBar #RpgCooldownSkill04 {
    Anchor: (Right: 458, Bottom: 72, Width: 58, Height: 58);
    MaskTexturePath: "Assets/RpgHud/CooldownMask.png";
    Color: #ff0000(0.50); Value: 0; Visible: false;
  }
  Label #RpgCountdownShadow01 {
    Anchor: (Right: 176, Bottom: 70, Width: 58, Height: 58);
    Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #000000(0.85)); Text: ""; Visible: false;
  }
  Label #RpgCountdown01 {
    Anchor: (Right: 176, Bottom: 72, Width: 58, Height: 58);
    Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #ffffe6); Text: ""; Visible: false;
  }
  Label #RpgCountdownShadow02 {
    Anchor: (Right: 82, Bottom: 70, Width: 58, Height: 58);
    Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #000000(0.85)); Text: ""; Visible: false;
  }
  Label #RpgCountdown02 {
    Anchor: (Right: 82, Bottom: 72, Width: 58, Height: 58);
    Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #ffffe6); Text: ""; Visible: false;
  }
  Label #RpgCountdownShadow03 { Anchor: (Right: 364, Bottom: 70, Width: 58, Height: 58); Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #000000(0.85)); Text: ""; Visible: false; }
  Label #RpgCountdown03 { Anchor: (Right: 364, Bottom: 72, Width: 58, Height: 58); Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #ffffe6); Text: ""; Visible: false; }
  Label #RpgCountdownShadow04 { Anchor: (Right: 458, Bottom: 70, Width: 58, Height: 58); Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #000000(0.85)); Text: ""; Visible: false; }
  Label #RpgCountdown04 { Anchor: (Right: 458, Bottom: 72, Width: 58, Height: 58); Style: (FontSize: 24, RenderBold: true, Alignment: Center, TextColor: #ffffe6); Text: ""; Visible: false; }
  Label #RpgResourceNotice01 {
    Anchor: (Right: 164, Bottom: 136, Width: 82, Height: 18);
    Background: (Color: #071629(0.85));
    Style: (FontSize: 12, RenderBold: true, Alignment: Center, TextColor: #76d8ff); Text: ""; Visible: false;
  }
  Label #RpgResourceNotice02 {
    Anchor: (Right: 70, Bottom: 136, Width: 82, Height: 18);
    Background: (Color: #071629(0.85));
    Style: (FontSize: 12, RenderBold: true, Alignment: Center, TextColor: #76d8ff); Text: ""; Visible: false;
  }
  Label #RpgResourceNotice03 { Anchor: (Right: 352, Bottom: 136, Width: 82, Height: 18); Background: (Color: #071629(0.85)); Style: (FontSize: 12, RenderBold: true, Alignment: Center, TextColor: #76d8ff); Text: ""; Visible: false; }
  Label #RpgResourceNotice04 { Anchor: (Right: 446, Bottom: 136, Width: 82, Height: 18); Background: (Color: #071629(0.85)); Style: (FontSize: 12, RenderBold: true, Alignment: Center, TextColor: #76d8ff); Text: ""; Visible: false; }
}
