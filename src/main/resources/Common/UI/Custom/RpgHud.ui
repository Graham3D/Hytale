      Group { Anchor: (Width: 30, Height: 14, Right: 5); Background: (Color: #26313fff); Group #XpPip4Fill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 12); Background: (Color: #e4b861); } }
      Group { Anchor: (Width: 30, Height: 14, Right: 5); Background: (Color: #26313fff); Group #XpPip5Fill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 12); Background: (Color: #e4b861); } }
      Group { Anchor: (Width: 30, Height: 14, Right: 5); Background: (Color: #26313fff); Group #XpPip6Fill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 12); Background: (Color: #e4b861); } }
      Group { Anchor: (Width: 30, Height: 14, Right: 5); Background: (Color: #26313fff); Group #XpPip7Fill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 12); Background: (Color: #e4b861); } }
      Group { Anchor: (Width: 30, Height: 14, Right: 5); Background: (Color: #26313fff); Group #XpPip8Fill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 12); Background: (Color: #e4b861); } }
