Group {
  Anchor: (Width: 74, Height: 74);
  HitTestVisible: false;
  Background: #58728a;
  Group #RarityFill { Anchor: (Full: 2); Background: #16283b; }
  Group #RarityArt { Visible: false; Anchor: (Full: 0); Background: #ffffff; }
  ItemIcon #Icon { Anchor: (Width: 56, Height: 56); }
  Group #PoseArt { Visible: false; HitTestVisible: false; Anchor: (Full: 0); }
  Label #Quantity {
    Anchor: (Right: 8, Bottom: 7, Height: 22);
    Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true);
  }
  Group #Dim { Anchor: (Full: 0); Background: #0b1320b3; Visible: false; }
  Group #Selected { Anchor: (Full: 0); Background: #d8ad5533; Visible: false; }
}
