$Common = "Common.ui";

Group {
  LayoutMode: Center;
  Group {
    Anchor: (Width: 1040, Height: 610);
    Background: (Color: #0a1019f2);
    Padding: (Full: 20);
    LayoutMode: Top;
    Label { Text: "R003 — LOW-LEVEL MOUSE FEASIBILITY"; Style: (FontSize: 25, TextColor: #f2d488, Alignment: Center); Anchor: (Height: 42); }
    Label { Text: "Hold left while moving to drag the node. Hold middle while moving to pan the fixed-zoom canvas."; Style: (FontSize: 15, TextColor: #c2cfdd, Alignment: Center); Anchor: (Height: 32); }
    Group #Canvas {
      Anchor: (Width: 1000, Height: 430);
      Background: (Color: #121d2bee);
      Group #CanvasContents { Anchor: (Full: 0); }
    }
    Label #MouseStatus { Text: "Waiting"; Style: (FontSize: 13, TextColor: #78c6d0); Anchor: (Height: 28); }
    Label #Counters { Text: "counters"; Style: (FontSize: 13, TextColor: #b6c2cf); Anchor: (Height: 28); }
    Label { Text: "Escape dismisses. Layout is restored on reopen. UI updates are capped at 10 Hz."; Style: (FontSize: 13, TextColor: #93a4b6, Alignment: Center); Anchor: (Height: 26); }
  }
}
