$Base = "../RpgInventory/GridCommon.ui";
Button #WorkspaceInput {
  Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000));
  Anchor: (Width: 1140, Height: 380);
$Base.@ProbeGrid #WorkspaceNativeGrid {
  InventorySectionId: 1;
  Anchor: (Width: 1140, Height: 380);
  SlotsPerRow: 15;
  Style: (...$Base.@ProbeGridStyle, SlotSize: 74, SlotSpacing: 2, SlotIconSize: 64);
  Padding: 0;
  RenderItemQualityBackground: false;
}
}
