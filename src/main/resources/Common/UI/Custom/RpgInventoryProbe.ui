$C = "Common.ui";

// Unified workspace; item authority follows the active native or spatial owner.
@Tab = TextButtonStyle(
  Default: (Background: #29455c, LabelStyle: (FontSize: 16, TextColor: #eef6ff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3d607a, LabelStyle: (FontSize: 16, TextColor: #d8ad55, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #1d3448, LabelStyle: (FontSize: 16, TextColor: #d8ad55, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Disabled: (Background: #1b2b39, LabelStyle: (FontSize: 16, TextColor: #778898, HorizontalAlignment: Center, VerticalAlignment: Center))
);

SceneBlur {}
Group #DropBackdrop { Background: #000000(0.55); }

Group {
  LayoutMode: Center;
  Group #Workspace {
    Anchor: (Full: 16, MaxWidth: 1240);
    LayoutMode: Top;
    Group #Ribbon {
      Anchor: (Height: 46); LayoutMode: Left; Background: #182b3d;
      Group { Anchor: (Width: 164, Height: 46); LayoutMode: Top; TextButton #RouteInventory { Text: "Inventory"; Anchor: (Height: 42); Style: @Tab; } Group #ActiveInventory { Anchor: (Height: 4); Background: #d8ad55; } }
      Group { Anchor: (Width: 154, Height: 46); LayoutMode: Top; TextButton #RouteSkills { Text: "Skills"; Anchor: (Height: 42); Style: @Tab; } Group { Anchor: (Height: 4); } }
      Group { Anchor: (Width: 154, Height: 46); LayoutMode: Top; TextButton #RouteQuests { Text: "Quests"; Anchor: (Height: 42); Style: @Tab; } Group #ActiveQuests { Visible: false; Anchor: (Height: 4); Background: #d8ad55; } }
      Group { Anchor: (Width: 154, Height: 46); LayoutMode: Top; TextButton #RouteBestiary { Text: "Bestiary"; Anchor: (Height: 42); Style: @Tab; } Group #ActiveBestiary { Visible: false; Anchor: (Height: 4); Background: #d8ad55; } }
      Group { Anchor: (Width: 154, Height: 46); LayoutMode: Top; TextButton #RouteMap { Text: "Map"; Anchor: (Height: 42); Style: @Tab; } Group #ActiveMap { Visible: false; Anchor: (Height: 4); Background: #d8ad55; } }
      Group { Anchor: (Width: 154, Height: 46); LayoutMode: Top; TextButton #RouteFriends { Text: "Friends"; Anchor: (Height: 42); Style: @Tab; } Group #ActiveFriends { Visible: false; Anchor: (Height: 4); Background: #d8ad55; } }
      Group { Anchor: (Width: 154, Height: 46); LayoutMode: Top; TextButton #RouteParty { Text: "Party"; Anchor: (Height: 42); Style: @Tab; } Group #ActiveParty { Visible: false; Anchor: (Height: 4); Background: #d8ad55; } }
      TextButton #Close { Text: "X"; Anchor: (Width: 60, Height: 42); Style: @Tab; }
    }
    Label #OwnershipNotice { Visible: false; Anchor: (Height: 0); }
    Group #BodyViewport { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; KeepScrollPosition: true;
    Group #InventoryContent {
      LayoutMode: Top;
      Group { Anchor: (Height: 430); LayoutMode: Left;
        $C.@Panel #CharacterFrame { Anchor: (Width: 340, Height: 430); LayoutMode: Top; Padding: (Full: 12);
          Group #CharacterHeader { Anchor: (Height: 38); Background: (TexturePath: "Icons/Hytale/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
            Group { HitTestVisible: false; Anchor: (Left: 40, Top: -5, Width: 236, Height: 11); Background: (TexturePath: "Icons/Hytale/ContainerDecorationTop.png"); }
            Label #PlayerName { Text: "Character"; Anchor: (Full: 0); Style: (FontName: "Secondary", FontSize: 17, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
          }
          Label #Level { Anchor: (Height: 22); Style: (FontSize: 14, TextColor: #a9c7df); }
          Group { Anchor: (Width: 312, Height: 8, Bottom: 8); Background: #0b1320;
            Group #XpFill { Anchor: (Left: 0, Top: 0, Width: 1, Height: 8); Background: #d8ad55; }
          }
          Group #AttributesPanel { Anchor: (Height: 195); LayoutMode: Top; Background: #14283d;
          Label { Text: "ATTRIBUTES"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
          Group { Anchor: (Height: 29); LayoutMode: Left; Label #Attribute0 { Anchor: (Width: 198, Height: 28); Style: (FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue0 { Anchor: (Width: 70, Height: 28); Style: (FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus0 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Tab; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Label #Attribute1 { Anchor: (Width: 198, Height: 28); Style: (FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue1 { Anchor: (Width: 70, Height: 28); Style: (FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus1 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Tab; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Label #Attribute2 { Anchor: (Width: 198, Height: 28); Style: (FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue2 { Anchor: (Width: 70, Height: 28); Style: (FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus2 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Tab; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Label #Attribute3 { Anchor: (Width: 198, Height: 28); Style: (FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue3 { Anchor: (Width: 70, Height: 28); Style: (FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus3 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Tab; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Label #Attribute4 { Anchor: (Width: 198, Height: 28); Style: (FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue4 { Anchor: (Width: 70, Height: 28); Style: (FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus4 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Tab; } }
          Label #Points { Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #d8ad55); }
          }
          Group #ResourcesPanel { Anchor: (Height: 118); LayoutMode: Top; Background: #14283d;
          Label { Text: "RESOURCES"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
          Group { Anchor: (Height: 30); LayoutMode: Left; Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Icons/Hytale/HealthIcon.png"); } Label { Text: "Health"; Anchor: (Width: 116, Height: 28); Style: (FontSize: 14, TextColor: #a9c7df); } Label #ResourceHealth { Anchor: (Width: 158, Height: 28); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } }
          Group { Anchor: (Height: 30); LayoutMode: Left; Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Icons/RPG/ManaIcon.png"); } Label { Text: "Mana"; Anchor: (Width: 116, Height: 28); Style: (FontSize: 14, TextColor: #a9c7df); } Label #ResourceMana { Anchor: (Width: 158, Height: 28); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } }
          Group { Anchor: (Height: 30); LayoutMode: Left; Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Icons/Hytale/StaminaIcon.png"); } Label { Text: "Stamina"; Anchor: (Width: 116, Height: 28); Style: (FontSize: 14, TextColor: #a9c7df); } Label #ResourceStamina { Anchor: (Width: 158, Height: 28); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } }
          }
        }
        Group { Anchor: (Width: 12); }
        $C.@Panel #GearFrame { Anchor: (Width: 480, Height: 430); LayoutMode: Left;
          Group { Anchor: (Width: 80); LayoutMode: Top; Padding: (Top: 10);
            Group { Anchor: (Height: 156); LayoutMode: Top; Label { Text: "WEAPON"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameWeapon { Anchor: (Width: 74, Height: 138); Group { Anchor: (Left: 0, Top: 0, Width: 74, Height: 74); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group { Anchor: (Left: 0, Bottom: 0, Width: 74, Height: 74); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } ItemIcon #EquipWeapon { Visible: false; Anchor: (Left: 6, Top: 38, Width: 62, Height: 62); } } }
            Group { Anchor: (Height: 88); LayoutMode: Top; Label { Text: "HEAD"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameHead { Anchor: (Width: 74, Height: 72); Group { Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group #EmptyHead { HitTestVisible: false; Anchor: (Left: 12, Top: 11, Width: 50, Height: 50); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconHead.png"); } ItemIcon #EquipHead { Visible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } } }
            Group { Anchor: (Height: 88); LayoutMode: Top; Label { Text: "CHEST"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameChest { Anchor: (Width: 74, Height: 72); Group { Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group #EmptyChest { HitTestVisible: false; Anchor: (Left: 12, Top: 11, Width: 50, Height: 50); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconChest.png"); } ItemIcon #EquipChest { Visible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } } }
            Group { Anchor: (Height: 88); LayoutMode: Top; Label { Text: "LEFT RING"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameRingLeft { Anchor: (Width: 74, Height: 72); Group { Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Button #RingEquipLeft { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #d8ad5533), Pressed: (Background: #d8ad5555)); } Group #RingEmptyLeft { HitTestVisible: false; Anchor: (Left: 10, Top: 10, Width: 54, Height: 54); Background: (TexturePath: "Icons/RPG/RingSlotIconLeft.png"); } ItemIcon #RingItemLeft { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 6, Width: 62, Height: 62); } } }
          }
          Group { Anchor: (Width: 320, Height: 430);
            Group { Anchor: (Left: 0, Top: 60, Width: 320, Height: 309); Background: (TexturePath: "Icons/Hytale/CharacterBackground.png"); }
            CharacterPreviewComponent #PlayerPreview { Anchor: (Width: 320, Height: 430); }
            Button #ArmorVisibility { Anchor: (Right: 8, Bottom: 8, Width: 28, Height: 28); TooltipText: "Toggle armor appearance";
              Group #ArmorVisibleIcon { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/ArmorVisibilityOn.png"); }
              Group #ArmorHiddenIcon { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/ArmorVisibilityOff.png"); }
            }
          }
          Group { Anchor: (Width: 80); LayoutMode: Top; Padding: (Top: 10);
            Group { Anchor: (Height: 156); LayoutMode: Top; Label { Text: "OFFHAND"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameOffhand { Anchor: (Width: 74, Height: 138); Group { Anchor: (Left: 0, Top: 0, Width: 74, Height: 74); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group { Anchor: (Left: 0, Bottom: 0, Width: 74, Height: 74); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group #EmptyOffhand { HitTestVisible: false; Anchor: (Left: 12, Top: 44, Width: 50, Height: 50); Background: (TexturePath: "Icons/Hytale/UtilitySlotIcon.png"); } ItemIcon #EquipOffhand { Visible: false; Anchor: (Left: 6, Top: 38, Width: 62, Height: 62); } } }
            Group { Anchor: (Height: 88); LayoutMode: Top; Label { Text: "HANDS"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameHands { Anchor: (Width: 74, Height: 72); Group { Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group #EmptyHands { HitTestVisible: false; Anchor: (Left: 12, Top: 11, Width: 50, Height: 50); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconHands.png"); } ItemIcon #EquipHands { Visible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } } }
            Group { Anchor: (Height: 88); LayoutMode: Top; Label { Text: "LEGS"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameLegs { Anchor: (Width: 74, Height: 72); Group { Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Group #EmptyLegs { HitTestVisible: false; Anchor: (Left: 12, Top: 11, Width: 50, Height: 50); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconLegs.png"); } ItemIcon #EquipLegs { Visible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } } }
            Group { Anchor: (Height: 88); LayoutMode: Top; Label { Text: "RIGHT RING"; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #a9c7df, Alignment: Center); } Group #EquipFrameRingRight { Anchor: (Width: 74, Height: 72); Group { Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/SlotDefault.png"); } Button #RingEquipRight { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #d8ad5533), Pressed: (Background: #d8ad5555)); } Group #RingEmptyRight { HitTestVisible: false; Anchor: (Left: 10, Top: 10, Width: 54, Height: 54); Background: (TexturePath: "Icons/RPG/RingSlotIconRight.png"); } ItemIcon #RingItemRight { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 6, Width: 62, Height: 62); } } }
          }
        }
        Group { Anchor: (Width: 12); }
        $C.@Panel #GlobalStatsFrame { Anchor: (Width: 372, Height: 430); LayoutMode: Top; Padding: (Full: 10);
          Group #CombatFrame { Anchor: (Height: 148); LayoutMode: Top;
            Label { Text: "COMBAT STATS"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMelee.png"); } Label { Text: "Weapon Damage"; Anchor: (Width: 194, Height: 27); Style: (FontSize: 14, TextColor: #a9c7df); } Label #WeaponDamage { Anchor: (Width: 126, Height: 27); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMelee.png"); } Label { Text: "Critical Chance"; Anchor: (Width: 194, Height: 27); Style: (FontSize: 14, TextColor: #a9c7df); } Label #Critical { Anchor: (Width: 126, Height: 27); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMagic.png"); } Label { Text: "Cooldown Recovery"; Anchor: (Width: 194, Height: 27); Style: (FontSize: 14, TextColor: #a9c7df); } Label #Cooldown { Anchor: (Width: 126, Height: 27); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMagic.png"); } Label { Text: "Magic Find"; Anchor: (Width: 194, Height: 27); Style: (FontSize: 14, TextColor: #a9c7df); } Label #MagicFind { Anchor: (Width: 126, Height: 27); Style: (FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
            Label #EquippedSpells { Visible: false; Anchor: (Height: 0); Style: (FontSize: 12, TextColor: #a9c7df); }
            TextButton #Refresh { Visible: false; Text: "Refresh"; Anchor: (Height: 0); Style: @Tab; }
          }
          Group { Anchor: (Height: 8); }
          Group #ResistanceFrame { Anchor: (Height: 196); LayoutMode: Top;
            Label { Text: "RESISTANCES"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
            Group #ResistanceSection { LayoutMode: Top;
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistWind.png"); } Label { Text: "Wind Resistance"; Anchor: (Width: 190, Height: 26); Style: (FontSize: 13, TextColor: #a9c7df); } Label #ResistWind { Anchor: (Width: 129, Height: 26); Style: (FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistWater.png"); } Label { Text: "Water Resistance"; Anchor: (Width: 190, Height: 26); Style: (FontSize: 13, TextColor: #a9c7df); } Label #ResistWater { Anchor: (Width: 129, Height: 26); Style: (FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistFire.png"); } Label { Text: "Fire Resistance"; Anchor: (Width: 190, Height: 26); Style: (FontSize: 13, TextColor: #a9c7df); } Label #ResistFire { Anchor: (Width: 129, Height: 26); Style: (FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistEarth.png"); } Label { Text: "Earth Resistance"; Anchor: (Width: 190, Height: 26); Style: (FontSize: 13, TextColor: #a9c7df); } Label #ResistEarth { Anchor: (Width: 129, Height: 26); Style: (FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistLightning.png"); } Label { Text: "Lightning Resistance"; Anchor: (Width: 190, Height: 26); Style: (FontSize: 13, TextColor: #a9c7df); } Label #ResistLightning { Anchor: (Width: 129, Height: 26); Style: (FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistVoid.png"); } Label { Text: "Void Resistance"; Anchor: (Width: 190, Height: 26); Style: (FontSize: 13, TextColor: #a9c7df); } Label #ResistVoid { Anchor: (Width: 129, Height: 26); Style: (FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Height: 1); Background: #29455c; } }
            }
          }
          Group { Anchor: (Height: 8); }
          TextButton #Advanced { Text: "ADVANCED STATS  ›"; Anchor: (Height: 32); Style: @Tab; }
        }
      }
      Group { Anchor: (Height: 12); }
      $C.@Panel #InventoryFrame { Anchor: (Width: 1216); LayoutMode: Top; Padding: (Horizontal: 30, Vertical: 8);
      Group { Anchor: (Height: 38); LayoutMode: Left; Padding: (Top: 3); Background: (TexturePath: "Icons/Hytale/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
        Label { Text: "INVENTORY"; Anchor: (Width: 778, Height: 32); Style: (FontName: "Secondary", FontSize: 17, TextColor: #ffffff, RenderBold: true); }
        Group { Anchor: (Width: 24, Height: 32); Group { Anchor: (Left: 4, Top: 8, Width: 16, Height: 16); Background: (TexturePath: "Icons/Hytale/SearchIcon.png"); } }
        TextField #Search { Anchor: (Width: 280, Height: 32); Background: #202b42; Padding: (Horizontal: 10, Vertical: 4); Style: (FontSize: 15, TextColor: #eef6ff); PlaceholderStyle: (FontSize: 15, TextColor: #9aa9b8); PlaceholderText: "Search..."; }
        TextButton #Clear { Text: "×"; Anchor: (Width: 38, Height: 32); Style: @Tab; }
        Button #Sort { Anchor: (Width: 36, Height: 32); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #d8ad5533), Pressed: (Background: #d8ad5555)); TooltipText: "Organize inventory"; Group { HitTestVisible: false; Anchor: (Left: 6, Top: 4, Width: 24, Height: 24); Background: (TexturePath: "Icons/Hytale/AutoSortIcon.png"); } }
        Label #MatchCount { Visible: false; Anchor: (Width: 0, Height: 0); Style: (FontSize: 13, TextColor: #9aa9b8, Alignment: Center); }
        TextButton #Cancel { Visible: false; Text: "Cancel selection"; Anchor: (Width: 0, Height: 0); Style: @Tab; }
      }
      Group #InventoryActions { Visible: false; Anchor: (Height: 0); LayoutMode: Left;
        TextButton #DropSelected { Text: "Drop"; Anchor: (Width: 86, Height: 32); Style: @Tab; }
        TextButton #QuickEquip { Text: "Equip / Move"; Anchor: (Width: 135, Height: 32); Style: @Tab; }
        Group #SpatialActions { Visible: false; LayoutMode: Left;
          TextButton #Consolidate { Text: "Combine"; Anchor: (Width: 110, Height: 32); Style: @Tab; }
          Label { Text: "Split"; Anchor: (Width: 52, Height: 32); Style: (FontSize: 13, TextColor: #a9c7df); }
          TextField #SplitQuantity { Anchor: (Width: 65, Height: 32); Background: #202b42; Padding: (Horizontal: 8, Vertical: 6); Style: (FontSize: 15, TextColor: #eef6ff); PlaceholderStyle: (FontSize: 15, TextColor: #9aa9b8); PlaceholderText: "Qty"; }
          TextButton #Split { Text: "Take"; Anchor: (Width: 70, Height: 32); Style: @Tab; }
        }
      }
      Group #BagShell { Anchor: (Width: 1156, Height: 396); Padding: (Full: 8); Background: #0b1320;
        Group #Bag { Anchor: (Width: 1140, Height: 380); }
      }
      Label #Coverage { Visible: false; Anchor: (Height: 0); }
      Label #ItemContext { Anchor: (Height: 16); Style: (FontSize: 12, TextColor: #a9c7df); }
      Label #Status { Anchor: (Height: 16); Style: (FontSize: 12, TextColor: #d8ad55); }
      }
    }
    Group #RouteContent { Visible: false; Anchor: (Height: 690); LayoutMode: Top; Padding: (Full: 12);
      Label #RouteMessage { Anchor: (Width: 1120, Height: 54); Style: (FontSize: 19, TextColor: #ffffff, Alignment: Center); }
      Label #RouteDetail { Anchor: (Width: 1120, Height: 60); Style: (FontSize: 15, TextColor: #dce6ed, Alignment: Center, Wrap: true); }
      Group #QuestsOverview { Visible: false; LayoutMode: Top;
        Label { Text: "ACTIVE OBJECTIVES"; Anchor: (Height: 42); Style: (FontSize: 18, TextColor: #ffffff, Alignment: Center); }
        Group { Anchor: (Width: 1120, Height: 500); LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #QuestRows { LayoutMode: Top; }
        }
      }
    }
    }
  }
  $C.@Panel #AdvancedStats { Visible: false; Anchor: (Right: 12, Top: 90, Bottom: 20, Width: 350); Padding: (Full: 12); LayoutMode: Top;
    Group { Anchor: (Height: 42); LayoutMode: Left; Background: #29455c;
      Label { Text: "ADVANCED STATS"; Anchor: (Width: 285, Height: 40); Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true); }
      TextButton #Back { Text: "X"; Anchor: (Width: 40, Height: 40); Style: @Tab; }
    }
    Group { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; KeepScrollPosition: true;
      Group #AdvancedRows { LayoutMode: Top; }
    }
    Label #AdvancedDetail { Anchor: (Height: 92); Style: (FontSize: 12, TextColor: #dce6ed, Wrap: true); }
  }
}
