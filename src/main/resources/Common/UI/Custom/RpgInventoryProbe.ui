$C = "Common.ui";

// Unified workspace; item authority follows the active native or spatial owner.
@Tab = TextButtonStyle(
  Default: (Background: #00000000, LabelStyle: (FontName: "Secondary", FontSize: 16, TextColor: #bbcedf, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: (TexturePath: "Icons/Hytale/NavigationItemHovered.png"), LabelStyle: (FontName: "Secondary", FontSize: 16, TextColor: #ffffff, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"), LabelStyle: (FontName: "Secondary", FontSize: 16, TextColor: #ffffff, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Disabled: (Background: #00000000, LabelStyle: (FontName: "Secondary", FontSize: 16, TextColor: #7c8b9966, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);
@Action = TextButtonStyle(
  Default: (Background: #29455c, LabelStyle: (FontName: "Secondary", FontSize: 15, TextColor: #eef6ff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3d607a, LabelStyle: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #1d3448, LabelStyle: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Disabled: (Background: #1b2b39, LabelStyle: (FontName: "Secondary", FontSize: 15, TextColor: #778898, HorizontalAlignment: Center, VerticalAlignment: Center))
);

SceneBlur {}
Group #DropBackdrop { Background: #000000(0.55); Group #OutsideDropHost { Anchor: (Full: 0); } }

Group {
  LayoutMode: Center;
  Group #Workspace {
    Anchor: (Full: 16, MaxWidth: 1164);
    LayoutMode: Top;
    Group #Ribbon {
      Anchor: (Height: 48); LayoutMode: Left; Background: (TexturePath: "Icons/Hytale/TopBarBackground.png", HorizontalBorder: 74, VerticalBorder: 12);
      Group { Anchor: (Width: 154, Height: 48); Group #ActiveInventory { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"); } TextButton #RouteInventory { Text: "Inventory"; Anchor: (Full: 0); Style: @Tab; } }
      Group { Anchor: (Width: 154, Height: 48); TextButton #RouteSkills { Text: "Skills"; Anchor: (Full: 0); Style: @Tab; } }
      Group { Anchor: (Width: 154, Height: 48); Group #ActiveQuests { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"); } TextButton #RouteQuests { Text: "Quests"; Anchor: (Full: 0); Style: @Tab; } }
      Group { Anchor: (Width: 154, Height: 48); Group #ActiveBestiary { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"); } TextButton #RouteBestiary { Text: "Bestiary"; Anchor: (Full: 0); Style: @Tab; } }
      Group { Anchor: (Width: 154, Height: 48); Group #ActiveMap { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"); } TextButton #RouteMap { Text: "Map"; Anchor: (Full: 0); Style: @Tab; } }
      Group { Anchor: (Width: 154, Height: 48); Group #ActiveFriends { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"); } TextButton #RouteFriends { Text: "Friends"; Anchor: (Full: 0); Style: @Tab; } }
      Group { Anchor: (Width: 154, Height: 48); Group #ActiveParty { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/NavigationItemSelected.png"); } TextButton #RouteParty { Text: "Party"; Anchor: (Full: 0); Style: @Tab; } }
      TextButton #Close { Text: "X"; Anchor: (Width: 60, Height: 48); Style: @Tab; }
    }
    Label #OwnershipNotice { Visible: false; Anchor: (Height: 0); }
    Group { Anchor: (Height: 12); }
    Group #BodyViewport { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; KeepScrollPosition: true;
    Group #InventoryContent {
      Anchor: (Width: 1164); LayoutMode: Top;
      Group { Anchor: (Width: 1164, Height: 430); LayoutMode: Left;
        Group #CharacterFrame { Anchor: (Width: 340, Height: 430); LayoutMode: Top;
          Group #CharacterHeader { Anchor: (Height: 38); Background: (TexturePath: "Icons/Hytale/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
            Group { HitTestVisible: false; Anchor: (Left: 52, Top: 0, Width: 236, Height: 11); Background: (TexturePath: "Icons/Hytale/ContainerDecorationTop.png"); }
            Label #PlayerName { Text: "Character"; Anchor: (Full: 0); Style: (FontName: "Secondary", FontSize: 17, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
          }
          Group #CharacterBody { Anchor: (Height: 392); LayoutMode: Top; Padding: (Full: 12); Background: (TexturePath: "Icons/Hytale/ContainerPatch.png", Border: 23);
          Group #LevelRow { Anchor: (Height: 22); LayoutMode: Left;
            Label #Level { Anchor: (Width: 80, Height: 22); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); }
            Label #Points { FlexWeight: 1; Anchor: (Height: 22); Style: (FontName: "Secondary", FontSize: 13, TextColor: #d8ad55, Alignment: End); }
          }
          Label #XpText { Anchor: (Height: 22); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); }
          Group { Anchor: (Width: 312, Height: 8, Bottom: 8); Background: #0b1320;
            Group #XpFill { Anchor: (Left: 0, Top: 0, Width: 1, Height: 8); Background: #d8ad55; }
          }
          Group #AttributesPanel { Anchor: (Height: 173); LayoutMode: Top; Background: #14283d;
          Label { Text: "ATTRIBUTES"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
          Group { Anchor: (Height: 29); LayoutMode: Left; Padding: (Left: 8); Label #Attribute0 { Anchor: (Width: 198, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue0 { Anchor: (Width: 70, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus0 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Action; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Padding: (Left: 8); Label #Attribute1 { Anchor: (Width: 198, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue1 { Anchor: (Width: 70, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus1 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Action; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Padding: (Left: 8); Label #Attribute2 { Anchor: (Width: 198, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue2 { Anchor: (Width: 70, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus2 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Action; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Padding: (Left: 8); Label #Attribute3 { Anchor: (Width: 198, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue3 { Anchor: (Width: 70, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus3 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Action; } }
          Group { Anchor: (Height: 29); LayoutMode: Left; Padding: (Left: 8); Label #Attribute4 { Anchor: (Width: 198, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #a9c7df); } Label #AttributeValue4 { Anchor: (Width: 70, Height: 28); Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, Alignment: End); } TextButton #AttributePlus4 { Text: "+"; Anchor: (Width: 30, Height: 28); Style: @Action; } }
          }
          Group #ResourcesPanel { Anchor: (Height: 118); LayoutMode: Top; Background: #14283d;
          Label { Text: "RESOURCES"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
          Group { Anchor: (Height: 30); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Icons/Hytale/HealthIcon.png"); } Label { Text: "Health"; Anchor: (Width: 116, Height: 28); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #ResourceHealth { Anchor: (Width: 158, Height: 28); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } }
          Group { Anchor: (Height: 30); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Icons/RPG/ManaIcon.png"); } Label { Text: "Mana"; Anchor: (Width: 116, Height: 28); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #ResourceMana { Anchor: (Width: 158, Height: 28); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } }
          Group { Anchor: (Height: 30); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Icons/Hytale/StaminaIcon.png"); } Label { Text: "Stamina"; Anchor: (Width: 116, Height: 28); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #ResourceStamina { Anchor: (Width: 158, Height: 28); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } }
          }
        }
        }
        Group { Anchor: (Width: 16); }
        $C.@Panel #GearFrame { Anchor: (Width: 480, Height: 430); LayoutMode: Left; Padding: (Horizontal: 12);
          Group { Anchor: (Width: 80); LayoutMode: Top;
            Group { Anchor: (Height: 160); Group #EquipFrameWeapon { Anchor: (Left: 3, Top: 12, Width: 74, Height: 148); Button #EquipDropWeapon { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/WeaponSlot.png"); } Group #EmptyWeapon { HitTestVisible: false; Anchor: (Left: 5, Top: 10, Width: 64, Height: 128); Background: (TexturePath: "Icons/Hytale/WeaponSlotIcon.png"); } ItemIcon #EquipWeapon { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 42, Width: 62, Height: 62); } Group #GearSelectedWeapon { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidWeapon { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconWeapon { HitTestVisible: false; Anchor: (Left: 6, Top: 42, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
            Group { Anchor: (Height: 86); Group #EquipFrameHead { Anchor: (Left: 3, Top: 12, Width: 74, Height: 74); Button #EquipDropHead { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/Slot.png"); } Group #EmptyHead { HitTestVisible: false; Anchor: (Left: 5, Top: 5, Width: 64, Height: 64); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconHead.png"); } ItemIcon #EquipHead { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group #GearSelectedHead { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidHead { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconHead { HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
            Group { Anchor: (Height: 86); Group #EquipFrameChest { Anchor: (Left: 3, Top: 12, Width: 74, Height: 74); Button #EquipDropChest { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/Slot.png"); } Group #EmptyChest { HitTestVisible: false; Anchor: (Left: 5, Top: 5, Width: 64, Height: 64); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconChest.png"); } ItemIcon #EquipChest { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group #GearSelectedChest { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidChest { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconChest { HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
            Group { Anchor: (Height: 86); Group #EquipFrameRingLeft { Anchor: (Left: 3, Top: 12, Width: 74, Height: 74); Group #EquipDropRingLeft { Anchor: (Full: 0); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/Slot.png"); } Button #RingEquipLeft { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group #RingEmptyLeft { HitTestVisible: false; Anchor: (Left: 5, Top: 5, Width: 64, Height: 64); Background: (TexturePath: "Icons/Hytale/RingSlotIconLeft.png"); } ItemIcon #RingItemLeft { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 6, Width: 62, Height: 62); } Group #GearSelectedRingLeft { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidRingLeft { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconRingLeft { HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
          }
          Group { Anchor: (Width: 296, Height: 430);
            Group { Anchor: (Width: 296, Height: 286, Bottom: -40); Background: (TexturePath: "Icons/Hytale/CharacterBackground.png"); }
            CharacterPreviewComponent #PlayerPreview { Anchor: (Width: 296, Height: 430); }
            Button #ArmorVisibility { Anchor: (Right: 8, Bottom: 8, Width: 28, Height: 28); TooltipText: "Toggle armor appearance"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group #ArmorVisibleIcon { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/ArmorVisibilityOn.png"); }
              Group #ArmorHiddenIcon { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/ArmorVisibilityOff.png"); }
            }
          }
          Group { Anchor: (Width: 80); LayoutMode: Top;
            Group { Anchor: (Height: 160); Group #EquipFrameOffhand { Anchor: (Left: 3, Top: 12, Width: 74, Height: 148); Button #EquipDropOffhand { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/WeaponSlot.png"); } Group #EmptyOffhand { HitTestVisible: false; Anchor: (Left: 5, Top: 10, Width: 64, Height: 128); Background: (TexturePath: "Icons/Hytale/WeaponSlotIconOffhand.png"); } ItemIcon #EquipOffhand { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 42, Width: 62, Height: 62); } Group #GearSelectedOffhand { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidOffhand { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconOffhand { HitTestVisible: false; Anchor: (Left: 6, Top: 42, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
            Group { Anchor: (Height: 86); Group #EquipFrameHands { Anchor: (Left: 3, Top: 12, Width: 74, Height: 74); Button #EquipDropHands { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/Slot.png"); } Group #EmptyHands { HitTestVisible: false; Anchor: (Left: 5, Top: 5, Width: 64, Height: 64); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconHands.png"); } ItemIcon #EquipHands { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group #GearSelectedHands { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidHands { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconHands { HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
            Group { Anchor: (Height: 86); Group #EquipFrameLegs { Anchor: (Left: 3, Top: 12, Width: 74, Height: 74); Button #EquipDropLegs { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/Slot.png"); } Group #EmptyLegs { HitTestVisible: false; Anchor: (Left: 5, Top: 5, Width: 64, Height: 64); Background: (TexturePath: "Icons/Hytale/ArmorSlotIconLegs.png"); } ItemIcon #EquipLegs { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group #GearSelectedLegs { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidLegs { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconLegs { HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
            Group { Anchor: (Height: 86); Group #EquipFrameRingRight { Anchor: (Left: 3, Top: 12, Width: 74, Height: 74); Group #EquipDropRingRight { Anchor: (Full: 0); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: (TexturePath: "Icons/Hytale/Slot.png"); } Button #RingEquipRight { Anchor: (Full: 0); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000)); } Group #RingEmptyRight { HitTestVisible: false; Anchor: (Left: 5, Top: 5, Width: 64, Height: 64); Background: (TexturePath: "Icons/Hytale/RingSlotIconRight.png"); } ItemIcon #RingItemRight { Visible: false; HitTestVisible: false; Anchor: (Left: 6, Top: 6, Width: 62, Height: 62); } Group #GearSelectedRingRight { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #d8ad55(0.18); } Group #GearInvalidRingRight { Visible: false; HitTestVisible: false; Anchor: (Full: 0); Background: #9d1d29(0.32); ItemIcon #GearInvalidIconRingRight { HitTestVisible: false; Anchor: (Left: 6, Top: 5, Width: 62, Height: 62); } Group { HitTestVisible: false; Anchor: (Full: 0); Background: #e52c38(0.56); } } } }
          }
        }
        Group { Anchor: (Width: 16); }
        $C.@Panel #GlobalStatsFrame { Anchor: (Width: 312, Height: 430); LayoutMode: Top; Padding: (Full: 8);
          Group #CombatFrame { Anchor: (Height: 148); LayoutMode: Top;
            Label { Text: "COMBAT STATS"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMelee.png"); } Label { Text: "Weapon Damage"; Anchor: (Width: 152, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #WeaponDamage { Anchor: (Width: 114, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMelee.png"); } Label { Text: "Critical Chance"; Anchor: (Width: 152, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #Critical { Anchor: (Width: 114, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMagic.png"); } Label { Text: "Cooldown Recovery"; Anchor: (Width: 152, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #Cooldown { Anchor: (Width: 114, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
            Group { Anchor: (Height: 30); LayoutMode: Top; Group { Anchor: (Height: 28); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 22, Height: 22); Background: (TexturePath: "Icons/Hytale/CharacterPanelStatIconMagic.png"); } Label { Text: "Magic Find"; Anchor: (Width: 152, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #a9c7df); } Label #MagicFind { Anchor: (Width: 114, Height: 27); Style: (FontName: "Secondary", FontSize: 14, TextColor: #ffffff, Alignment: End); } } }
            Label #EquippedSpells { Visible: false; Anchor: (Height: 0); Style: (FontName: "Secondary", FontSize: 12, TextColor: #a9c7df); }
            TextButton #Refresh { Visible: false; Text: "Refresh"; Anchor: (Height: 0); Style: @Action; }
          }
          Group { Anchor: (Height: 8); }
          Group #ResistanceFrame { Anchor: (Height: 196); LayoutMode: Top;
            Label { Text: "RESISTANCES"; Anchor: (Height: 28); Background: #29455c; Style: (FontName: "Secondary", FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center); }
            Group #ResistanceSection { LayoutMode: Top;
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistWind.png"); } Label { Text: "Wind Resistance"; Anchor: (Width: 151, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); } Label #ResistWind { Anchor: (Width: 114, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistWater.png"); } Label { Text: "Water Resistance"; Anchor: (Width: 151, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); } Label #ResistWater { Anchor: (Width: 114, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistFire.png"); } Label { Text: "Fire Resistance"; Anchor: (Width: 151, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); } Label #ResistFire { Anchor: (Width: 114, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistEarth.png"); } Label { Text: "Earth Resistance"; Anchor: (Width: 151, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); } Label #ResistEarth { Anchor: (Width: 114, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistLightning.png"); } Label { Text: "Lightning Resistance"; Anchor: (Width: 151, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); } Label #ResistLightning { Anchor: (Width: 114, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #ffffff, Alignment: End); } } Group { Anchor: (Width: 296, Height: 1); Background: #29455c(0.65); } }
              Group { Anchor: (Height: 28); LayoutMode: Top; Group { Anchor: (Height: 26); LayoutMode: Left; Padding: (Left: 8); Group { Anchor: (Width: 23, Height: 23); Background: (TexturePath: "Icons/RPG/ResistVoid.png"); } Label { Text: "Void Resistance"; Anchor: (Width: 151, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); } Label #ResistVoid { Anchor: (Width: 114, Height: 26); Style: (FontName: "Secondary", FontSize: 13, TextColor: #ffffff, Alignment: End); } } }
            }
          }
          Group { Anchor: (Height: 8); }
          TextButton #Advanced { Text: "ADVANCED STATS  ›"; Anchor: (Height: 32); Style: @Action; }
        }
      }
      Group { Anchor: (Height: 16); }
      Group #InventoryFrame { Anchor: (Width: 1164); LayoutMode: Top;
      Group #InventoryHeader { Anchor: (Height: 38); LayoutMode: Left; Padding: (Horizontal: 12, Top: 3); Background: (TexturePath: "Icons/Hytale/ContainerHeaderNoRunes.png", HorizontalBorder: 35, VerticalBorder: 0);
        Label { Text: "INVENTORY"; Anchor: (Width: 804, Height: 32); Style: (FontName: "Secondary", FontSize: 17, TextColor: #ffffff, RenderBold: true); }
        Group { Anchor: (Width: 300, Height: 32);
          CompactTextField #Search {
            Anchor: (Height: 30, Right: 0);
            CollapsedWidth: 34;
            ExpandedWidth: 300;
            PlaceholderText: "Search...";
            Style: (FontName: "Secondary", FontSize: 15, TextColor: #eef6ff);
            PlaceholderStyle: (FontName: "Secondary", FontSize: 14, TextColor: #9aa9b8);
            Padding: (Horizontal: 12, Left: 34);
            Decoration: (Default: (
              Icon: (Texture: "Icons/Hytale/SearchIcon.png", Width: 16, Height: 16, Offset: 9),
              ClearButtonStyle: (
                Texture: (TexturePath: "Icons/Hytale/ClearInputIcon.png", Color: #ffffff(0.3)),
                HoveredTexture: (TexturePath: "Icons/Hytale/ClearInputIcon.png", Color: #ffffff(0.5)),
                PressedTexture: (TexturePath: "Icons/Hytale/ClearInputIcon.png", Color: #ffffff(0.4)),
                Width: 16, Height: 16, Side: Right, Offset: 10
              )
            ));
          }
        }
        Button #Sort { Anchor: (Width: 36, Height: 32); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #d8ad5533), Pressed: (Background: #d8ad5555)); TooltipText: "Organize inventory"; TextTooltipStyle: $C.@DefaultTextTooltipStyle; Group { HitTestVisible: false; Anchor: (Left: 6, Top: 4, Width: 24, Height: 24); Background: (TexturePath: "Icons/Hytale/AutoSortIcon.png"); } }
        Label #MatchCount { Visible: false; Anchor: (Width: 0, Height: 0); Style: (FontName: "Secondary", FontSize: 13, TextColor: #9aa9b8, Alignment: Center); }
        TextButton #Cancel { Visible: false; Text: "Cancel selection"; Anchor: (Width: 0, Height: 0); Style: @Action; }
      }
      Group #InventoryBody { LayoutMode: Top; Padding: (Horizontal: 12, Top: 12, Bottom: 12); Background: (TexturePath: "Icons/Hytale/ContainerPatch.png", Border: 23);
      Group #InventoryActions { Visible: false; Anchor: (Height: 0); LayoutMode: Left;
        TextButton #DropSelected { Text: "Drop"; Anchor: (Width: 86, Height: 32); Style: @Action; }
        TextButton #QuickEquip { Text: "Equip / Move"; Anchor: (Width: 135, Height: 32); Style: @Action; }
        Group #SpatialActions { Visible: false; LayoutMode: Left;
          TextButton #Consolidate { Text: "Combine"; Anchor: (Width: 110, Height: 32); Style: @Action; }
          Label { Text: "Split"; Anchor: (Width: 52, Height: 32); Style: (FontName: "Secondary", FontSize: 13, TextColor: #a9c7df); }
          TextField #SplitQuantity { Anchor: (Width: 65, Height: 32); Background: #202b42; Padding: (Horizontal: 8, Vertical: 6); Style: (FontName: "Secondary", FontSize: 15, TextColor: #eef6ff); PlaceholderStyle: (FontName: "Secondary", FontSize: 15, TextColor: #9aa9b8); PlaceholderText: "Qty"; }
          TextButton #Split { Text: "Take"; Anchor: (Width: 70, Height: 32); Style: @Action; }
        }
      }
      Group #Bag { Anchor: (Width: 1140, Height: 380); }
      Label #Coverage { Visible: false; Anchor: (Height: 0); }
      Label #ItemContext { Visible: false; Anchor: (Height: 0); }
      Label #Status { Visible: false; Anchor: (Height: 0); }
      }
      }
    }
    Group #RouteContent { Visible: false; Anchor: (Height: 690); LayoutMode: Top; Padding: (Full: 12);
      Label #RouteMessage { Anchor: (Width: 1120, Height: 54); Style: (FontName: "Secondary", FontSize: 19, TextColor: #ffffff, Alignment: Center); }
      Label #RouteDetail { Anchor: (Width: 1120, Height: 60); Style: (FontName: "Secondary", FontSize: 15, TextColor: #dce6ed, Alignment: Center, Wrap: true); }
      Group #QuestsOverview { Visible: false; LayoutMode: Top;
        Label { Text: "ACTIVE OBJECTIVES"; Anchor: (Height: 42); Style: (FontName: "Secondary", FontSize: 18, TextColor: #ffffff, Alignment: Center); }
        Group { Anchor: (Width: 1120, Height: 500); LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #QuestRows { LayoutMode: Top; }
        }
      }
    }
    }
  }
  $C.@Panel #AdvancedStats { Visible: false; Anchor: (Right: 12, Top: 90, Bottom: 20, Width: 350); Padding: (Full: 12); LayoutMode: Top;
    Group { Anchor: (Height: 42); LayoutMode: Left; Background: #29455c;
      Label { Text: "ADVANCED STATS"; Anchor: (Width: 285, Height: 40); Style: (FontName: "Secondary", FontSize: 18, TextColor: #ffffff, RenderBold: true); }
      TextButton #Back { Text: "X"; Anchor: (Width: 40, Height: 40); Style: @Action; }
    }
    Group { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; KeepScrollPosition: true;
      Group #AdvancedRows { LayoutMode: Top; }
    }
    Label #AdvancedDetail { Anchor: (Height: 92); Style: (FontName: "Secondary", FontSize: 12, TextColor: #dce6ed, Wrap: true); }
  }
}
// A separate root layer overlays the page without participating in its Center layout.
Group #RequirementToast { Visible: false; HitTestVisible: false; Anchor: (Full: 0); LayoutMode: Center;
    Group { Anchor: (Width: 600, Height: 60);
      Group #ToastLow { Visible: false; Anchor: (Full: 0); Background: #090f1c(0.20);
        Label #ToastLowText { Anchor: (Full: 0); Style: (FontName: "Secondary", FontSize: 24, TextColor: #ff6666(0.35), RenderBold: true, Alignment: Center); }
      }
      Group #ToastMedium { Visible: false; Anchor: (Full: 0); Background: #090f1c(0.42);
        Label #ToastMediumText { Anchor: (Full: 0); Style: (FontName: "Secondary", FontSize: 24, TextColor: #ff6666(0.70), RenderBold: true, Alignment: Center); }
      }
      Group #ToastFull { Visible: false; Anchor: (Full: 0); Background: #090f1c(0.65);
        Label #ToastFullText { Anchor: (Full: 0); Style: (FontName: "Secondary", FontSize: 24, TextColor: #ff7777, RenderBold: true, Alignment: Center); }
      }
    }
}

// Separate centered overlay layer: the tooltip never participates in the
// inventory's Top/Left layout and cannot shift the menu or receive drag input.
Group { LayoutMode: Center; HitTestVisible: false;
  // Center has exactly one child. Both tooltip hosts overlay the same workspace.
  Group #TooltipWorkspace { Anchor: (Full: 16, MaxWidth: 1164); HitTestVisible: false;
    Group #ComparisonTooltipHost { Anchor: (Full: 0); HitTestVisible: false; }
    Group #ManagedTooltipHost { Anchor: (Full: 0); HitTestVisible: false; }
  }
}
