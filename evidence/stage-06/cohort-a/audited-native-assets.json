  {
    "document": {
      "Class": "EncounterManager",
      "Type": "Generic",
      "StartState": "Phase_1",
      "Debug": "DisplayState,DisplayTarget",
      "Instructions": [
        {
          "$Comment": "Capture the nearest Skeleton Elite so the encounter can preserve it through role changes.",
          "Continue": true,
          "Sensor": {
            "Type": "Mob",
            "Range": 30,
            "LockOnTarget": true,
            "LockedTargetSlot": "EncounterTarget",
            "Rebind": true,
            "Filters": [
              {
                "Type": "NPCGroup",
                "IncludeGroups": [
                  "Skeleton_Elite_Encounter_Target"
                ]
              }
            ]
          },
          "Actions": [
            {
              "Type": "Nothing"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Phase_1"
          },
          "Instructions": [
            {
              "$Comment": "Prevent phase 1 death at critical health, then enter phase 2 at full health.",
              "Sensor": {
                "Type": "Target",
                "Range": 100,
                "TargetSlot": "EncounterTarget",
                "Filters": [
                  {
                    "Type": "Stat",
                    "StatTarget": "Value",
                    "RelativeTo": "Health",
                    "Stat": "Health",
                    "RelativeToTarget": "Max",
                    "ValueRange": [
                      0,
                      0.1
                    ]
                  }
                ]
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "SetTargetNPCInvulnerable",
                  "Invulnerable": true
                },
                {
                  "Type": "ChangeTargetRole",
                  "Role": "Skeleton_Elite_Phase_2",
                  "ChangeAppearance": true,
                  "State": "Combat.Revive"
                },
                {
                  "Type": "State",
                  "State": "Phase_2"
                }
              ]
            },
            {
              "$Comment": "Switch the tracked NPC to phase 2 after shield damage breaks its stamina.",
              "Sensor": {
                "Type": "Target",
                "Range": 100,
                "TargetSlot": "EncounterTarget",
                "Filters": [
                  {
                    "Type": "EntityEffect",
                    "EffectId": "Stamina_Broken"
                  },
                  {
                    "$Comment": "Let the critical-health transition own the role swap when both conditions match.",
                    "Type": "Not",
                    "Filter": {
                      "Type": "Stat",
                      "StatTarget": "Value",
                      "RelativeTo": "Health",
                      "Stat": "Health",
                      "RelativeToTarget": "Max",
                      "ValueRange": [
                        0,
                        0.1
                      ]
                    }
                  }
                ]
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "$Comment": "Protect the NPC until phase 2 restores its health.",
                  "Type": "SetTargetNPCInvulnerable",
                  "Invulnerable": true
                },
                {
                  "Type": "Timeout",
                  "Delay": [
                    1.55,
                    1.55
                  ]
                },
                {
                  "Type": "ChangeTargetRole",
                  "Role": "Skeleton_Elite_Phase_2",
                  "ChangeAppearance": true,
                  "State": "Combat.Unsheath"
                },
                {
                  "Type": "State",
                  "State": "Phase_2"
                }
              ]
            },
            {
              "$Comment": "Trigger one authored phase 1 spawn marker after a player approaches the encounter.",
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Target",
                  "TargetSlot": "EncounterTarget",
                  "Range": 100
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Player",
                    "Range": 30,
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "TriggerSpawners",
                      "SpawnMarker": "Skeleton_Elite_Manual",
                      "Range": 30,
                      "Count": 1,
                      "TargetSlot": "EncounterTarget",
                      "Rebind": true
                    }
                  ]
                }
              ]
            },
            {
              "Actions": [
                {
                  "Type": "Nothing"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Phase_2"
          },
          "Instructions": [
            {
              "Reference": "Encounter_Macro_Transition_TargetGone",
              "Modify": {
                "_ExportStates": [
                  "Complete"
                ],
                "Slot": "EncounterTarget",
                "Range": 100
              }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Complete"
          },
          "Actions": [
            {
              "Type": "Nothing"
            }
          ]
        }
      ]
    },
    "path": "Server/EncounterManager/Encounter_Skeleton_Elite.json"
