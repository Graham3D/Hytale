$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer {
    Anchor: (Width: 1370, Height: 490);
    #Title { $C.@Title #ProbeTitle { @Text = "NATIVE INVENTORY PROBE"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);
      Label #OrderingText {
        Anchor: (Height: 24, Bottom: 2);
        Text: "Packet ordering";
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9ed7a6,
          HorizontalAlignment: Center);
      }
      Label #SectionText {
        Anchor: (Height: 22, Bottom: 10);
        Text: "Inventory sections";
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #aebdcb,
          HorizontalAlignment: Center);
      }
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 6);
          Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
          Padding: (Full: 10);
          Label { Anchor: (Height: 28, Bottom: 6); Text: "40-SLOT TEST / NPC CONTAINER";
            Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #f1f5f9,
              HorizontalAlignment: Center); }
          Group #NpcGridHost { LayoutMode: Center; FlexWeight: 1; }
        }
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Left: 6);
          Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
          Padding: (Full: 10);
          Label { Anchor: (Height: 28, Bottom: 6); Text: "VIEWING PLAYER STORAGE";
            Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #f1f5f9,
              HorizontalAlignment: Center); }
          Group #PlayerGridHost { LayoutMode: Center; FlexWeight: 1; }
        }
      }
      $C.@SecondaryTextButton #CloseButton {
        @Sounds = $Sounds.@ButtonsCancel;
        @Anchor = (Top: 10, Height: 40);
        Text: "CLOSE PROBE";
      }
    }
  }
}

$C.@BackButton {}
