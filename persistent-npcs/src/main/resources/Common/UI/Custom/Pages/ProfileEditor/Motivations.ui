$C = "../../Common.ui";
Label { Anchor: (Height: 34, Bottom: 10); Text: "MOTIVATIONS"; Style: (...$C.@DefaultLabelStyle, FontSize: 19, RenderBold: true, TextColor: #d5a842); }
Label { Anchor: (Height: 22); Text: "Purpose"; Style: (...$C.@DefaultLabelStyle, TextColor: #91a5b7); }
MultilineTextField #ProfilePurposeInput { Anchor: (Height: 130, Bottom: 10); Background: $C.@InputBoxBackground; MaxVisibleLines: 6; AutoGrow: false; MaxLength: 900; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; }
Label { Anchor: (Height: 22); Text: "Goals, desires, and ambitions"; Style: (...$C.@DefaultLabelStyle, TextColor: #91a5b7); }
MultilineTextField #ProfileGoalsInput { Anchor: (Height: 110, Bottom: 10); Background: $C.@InputBoxBackground; MaxVisibleLines: 5; AutoGrow: false; MaxLength: 900; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; }
Label { Anchor: (Height: 22); Text: "Fears and obligations"; Style: (...$C.@DefaultLabelStyle, TextColor: #91a5b7); }
MultilineTextField #ProfileFearsInput { Anchor: (Height: 110); Background: $C.@InputBoxBackground; MaxVisibleLines: 5; AutoGrow: false; MaxLength: 700; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; }
Group { FlexWeight: 1; }
