$C = "../Common.ui";

Button #Choice {
  Style: $C.@SecondaryButtonStyle;
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  Label #Id { Visible: false; Text: ""; }
  Group #Icon { HitTestVisible: false; Anchor: (Left: 22, Top: 10, Width: 48, Height: 36); }
  Label #Name { HitTestVisible: false; Anchor: (Left: 5, Right: 5, Top: 49, Bottom: 6); Text: ""; Style: (...$C.@DefaultLabelStyle, FontSize: 11, Wrap: true, TextColor: #c7d5e1, HorizontalAlignment: Center, VerticalAlignment: Center); }
  Group #Selected { HitTestVisible: false; Visible: false; Anchor: (Left: 2, Right: 2, Bottom: 0, Height: 3); Background: #e4bc60; }
}
