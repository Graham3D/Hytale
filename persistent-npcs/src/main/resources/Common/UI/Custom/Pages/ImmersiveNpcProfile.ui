$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@NpcItemGridStyle = ItemGridStyle(
  SlotSpacing: 2,
  SlotSize: 62,
  SlotIconSize: 54,
  SlotBackground: "ImmersiveNpcInventory/Slot.png",
  QuantityPopupSlotOverlay: "ImmersiveNpcInventory/QuantityPopupSlotOverlay.png",
  BrokenSlotBackgroundOverlay: "ImmersiveNpcInventory/SlotItemBrokenCracksOverlay.png",
  BrokenSlotIconOverlay: "ImmersiveNpcInventory/SlotItemBrokenIconOverlay.png",
  DefaultItemIcon: "ImmersiveNpcInventory/UnknownItemIcon.png",
  DurabilityBar: "ImmersiveNpcInventory/DurabilityBar.png",
  DurabilityBarBackground: "ImmersiveNpcInventory/DurabilityBarBackground.png",
  DurabilityBarAnchor: (Bottom: 8, Left: 11, Width: 40, Height: 2),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  CursedIconPatch: "ImmersiveNpcInventory/CursedSpiral.png",
  CursedIconAnchor: (Bottom: 67, Left: 46, Width: 21, Height: 21)
);

@EquipmentItemGridStyle = (
  ...@NpcItemGridStyle,
  SlotSpacing: 10,
  SlotSize: 58,
  SlotIconSize: 50,
  DurabilityBarAnchor: (Bottom: 8, Left: 9, Width: 40, Height: 2)
);

@PanelBackground = (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
@GoldPanel = #5a431f;
@Cyan = #55c6cf;
@Gold = #d8ad55;
@Muted = #9aa9b8;
@Gap = 12;
@HalfGap = 6;
@Padding = 12;
@GearRowsHeight = 262;
@RecorderSurface = #0d1822;
@RecorderRow = #0d1822;
@RecorderWaveform = #6d8798;
@RecorderBaseline = #496274;

@VoiceSelectionMarker = Group {
  @Visible = true;
  Visible: @Visible;
  Anchor: (Width: 30, Height: 24, Left: 5);
  LayoutMode: CenterMiddle;
  Background: #b58a38;
  Padding: (Full: 2);
  Group {
    Anchor: (Width: 24, Height: 20);
    Background: #182b3d;
    LayoutMode: CenterMiddle;
    Group { Anchor: (Width: 18, Height: 18); Background: "ImmersiveNpcInventory/NpcIconSelectSample.png"; }
  }
};

@VoiceSummaryRow = Group {
  @Sample = "Sample";
  LayoutMode: Left;
  Anchor: (Height: 20, Bottom: 2);
  Background: #14202b;
  Padding: (Horizontal: 5);
  Label #VoiceSampleName { Anchor: (Width: 88); Text: @Sample; Style: (...$C.@DefaultLabelStyle, FontSize: 9, VerticalAlignment: Center); }
  Label #VoiceFilename { FlexWeight: 1; Text: "Not found"; Style: (...$C.@DefaultLabelStyle, TextColor: #aebdcb, FontSize: 8, VerticalAlignment: Center); }
  Label #VoiceState { Anchor: (Width: 50); Text: "Missing"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, TextColor: #d0a65a, VerticalAlignment: Center); }
};

@StatCell = Group {
  @Label = "STAT";
  @Accent = #d8ad55;
  FlexWeight: 1;
  LayoutMode: Top;
  Anchor: (Right: 3, Left: 3);
  Background: #101a24;
  Padding: (Full: 7);
  Label { Anchor: (Height: 16); Text: @Label; Style: (...$C.@DefaultLabelStyle, FontSize: 9, RenderBold: true, TextColor: @Accent, HorizontalAlignment: Center); }
  Label #Value { FlexWeight: 1; Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 15, RenderBold: true, TextColor: #e7edf3, HorizontalAlignment: Center, VerticalAlignment: Center); }
};

$C.@PageOverlay #ProfilePage {
  LayoutMode: Middle;
  Group #AuthoringWorkspace {
    Anchor: (Width: 1520, Height: 960);
    LayoutMode: Top;

    Label #AuthoringSessionValue { Visible: false; Text: ""; }
    Label #AuthoringViewerValue { Visible: false; Text: ""; }
    Label #AuthoringNpcValue { Visible: false; Text: ""; }
    Label #AuthoringPageGeneration { Visible: false; Text: ""; }
    Label #AuthoringEditorValue { Visible: false; Text: "NONE"; }
    Label #AuthoringEditorGeneration { Visible: false; Text: "1"; }

    Group #WorkspaceHeader {
      Anchor: (Height: 42, Bottom: @Gap);
      Background: #152536;
      Padding: (Horizontal: 14);
      LayoutMode: Left;
      Label #ProfileTitle { FlexWeight: 1; Text: "NPC AUTHORING STUDIO"; Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, RenderUppercase: true, TextColor: #d9e6ef, VerticalAlignment: Center); }
      Label { Anchor: (Width: 390); Text: "LIVE INVENTORY · EXPLICIT DRAFT SAVES"; Style: (...$C.@DefaultLabelStyle, FontSize: 9, TextColor: #7fa2b8, HorizontalAlignment: End, VerticalAlignment: Center); }
    }

    Group #TopWorkspace {
      LayoutMode: Left;
      Anchor: (Height: 452, Bottom: @Gap);
      Group #GearPanel {
        LayoutMode: Top;
        Anchor: (Width: 724, Right: @HalfGap);
        Background: @PanelBackground;
        Padding: (Full: @Padding);
        Label { Anchor: (Height: 30, Bottom: 6); Text: "NPC GEAR + LIVE STATS"; Style: (...$C.@DefaultLabelStyle, FontSize: 17, RenderBold: true, TextColor: @Gold, HorizontalAlignment: Center); }
        Group #GearWorkspace {
          LayoutMode: Left;
          Anchor: (Height: 294, Bottom: 8);
          Group #ArmorSlotColumn {
            Anchor: (Width: 156, Height: @GearRowsHeight, Right: 4, Top: 16);
            ItemGrid #ArmorGrid { Anchor: (Width: 58, Height: @GearRowsHeight, Left: 44); SlotsPerRow: 1; Style: @EquipmentItemGridStyle; Background: #000000(0); Padding: 0; ShowScrollbar: false; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; RenderItemQualityBackground: true; RenderEmptySlots: true; }
            Group #HeadEmptyIcon { HitTestVisible: false; Anchor: (Width: 40, Height: 40, Left: 53, Top: 7); Background: "ImmersiveNpcInventory/ArmorSlotIconHead.png"; }
            Group #ChestEmptyIcon { HitTestVisible: false; Anchor: (Width: 40, Height: 40, Left: 53, Top: 75); Background: "ImmersiveNpcInventory/ArmorSlotIconChest.png"; }
            Group #HandsEmptyIcon { HitTestVisible: false; Anchor: (Width: 40, Height: 40, Left: 53, Top: 143); Background: "ImmersiveNpcInventory/ArmorSlotIconHands.png"; }
            Group #LegsEmptyIcon { HitTestVisible: false; Anchor: (Width: 40, Height: 40, Left: 53, Top: 211); Background: "ImmersiveNpcInventory/ArmorSlotIconLegs.png"; }
            Button #ToggleHelmetVisibilityButton { Anchor: (Width: 26, Height: 26, Left: 108, Top: 14); TextTooltipStyle: $C.@DefaultTextTooltipStyle; Group #HelmetArmorVisible { Background: "ImmersiveNpcInventory/ArmorVisibilityOn.png"; } Group #HelmetArmorHidden { Background: "ImmersiveNpcInventory/ArmorVisibilityOff.png"; Visible: false; } }
            Button #ToggleCuirassVisibilityButton { Anchor: (Width: 26, Height: 26, Left: 108, Top: 82); TextTooltipStyle: $C.@DefaultTextTooltipStyle; Group #CuirassArmorVisible { Background: "ImmersiveNpcInventory/ArmorVisibilityOn.png"; } Group #CuirassArmorHidden { Background: "ImmersiveNpcInventory/ArmorVisibilityOff.png"; Visible: false; } }
            Button #ToggleGauntletsVisibilityButton { Anchor: (Width: 26, Height: 26, Left: 108, Top: 150); TextTooltipStyle: $C.@DefaultTextTooltipStyle; Group #GauntletsArmorVisible { Background: "ImmersiveNpcInventory/ArmorVisibilityOn.png"; } Group #GauntletsArmorHidden { Background: "ImmersiveNpcInventory/ArmorVisibilityOff.png"; Visible: false; } }
            Button #TogglePantsVisibilityButton { Anchor: (Width: 26, Height: 26, Left: 108, Top: 218); TextTooltipStyle: $C.@DefaultTextTooltipStyle; Group #PantsArmorVisible { Background: "ImmersiveNpcInventory/ArmorVisibilityOn.png"; } Group #PantsArmorHidden { Background: "ImmersiveNpcInventory/ArmorVisibilityOff.png"; Visible: false; } }
          }
          Group #NpcAppearancePanel {
            LayoutMode: Top;
            Anchor: (Width: 300, Height: 294, Left: 6, Right: 6);
            Background: @GoldPanel;
            Padding: (Full: 8);
            Label #NpcPreviewName { Anchor: (Height: 26); Text: "NPC"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 15, TextColor: #f1dfae, HorizontalAlignment: Center); }
            Group #NpcPreviewContainer { FlexWeight: 1; LayoutMode: CenterMiddle; Background: "ImmersiveNpcInventory/NPCBackground.png";
              CharacterPreviewComponent #NpcCharacterPreview { Anchor: (Width: 250, Height: 248); }
              Label #NpcPreviewUnavailable { Anchor: (Width: 230, Height: 80); Text: "Save a profile and appearance to enable preview."; Visible: false; Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 10, TextColor: #d7c28c, HorizontalAlignment: Center, VerticalAlignment: Center); }
            }
          }
          Group #LoadoutSlotColumn {
            Anchor: (Width: 208, Height: @GearRowsHeight, Left: 4, Top: 16);
            ItemGrid #PrimaryWeaponGrid { Anchor: (Width: 58, Height: 58, Left: 34, Top: 0); SlotsPerRow: 1; Style: @EquipmentItemGridStyle; Background: #000000(0); Padding: 0; ShowScrollbar: false; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; RenderItemQualityBackground: true; RenderEmptySlots: true; }
            ItemGrid #OffhandGrid { Anchor: (Width: 58, Height: 58, Left: 34, Top: 68); SlotsPerRow: 1; Style: @EquipmentItemGridStyle; Background: #000000(0); Padding: 0; ShowScrollbar: false; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; RenderItemQualityBackground: true; RenderEmptySlots: true; }
            ItemGrid #AmmunitionGrid { Anchor: (Width: 58, Height: 58, Left: 34, Top: 136); SlotsPerRow: 1; Style: @EquipmentItemGridStyle; Background: #000000(0); Padding: 0; ShowScrollbar: false; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; RenderItemQualityBackground: true; RenderEmptySlots: true; }
            Group #PrimaryWeaponEmptyIcon { HitTestVisible: false; Anchor: (Width: 36, Height: 36, Left: 45, Top: 10); Background: "ImmersiveNpcInventory/WeaponSlotIconSword.png"; }
            Group #OffhandEmptyIcon { HitTestVisible: false; Anchor: (Width: 36, Height: 36, Left: 45, Top: 78); Background: "ImmersiveNpcInventory/WeaponSlotIconShield.png"; }
            Group #AmmoEmptyIcon { HitTestVisible: false; Anchor: (Width: 36, Height: 36, Left: 45, Top: 146); Background: "ImmersiveNpcInventory/WeaponSlotIconAmmo.png"; }
            Group { LayoutMode: Top; Anchor: (Top: 204, Height: 58, Left: 6);
              Group { LayoutMode: Left; Anchor: (Height: 26); $C.@CheckBox #InfiniteAmmoCheckBox { Value: false; TooltipText: "Toggle for infinite ammunition."; } Label { Anchor: (Left: 6); Text: "Infinite Ammo"; Style: (...$C.@DefaultLabelStyle, FontSize: 10, VerticalAlignment: Center); } }
              Label #InfiniteAmmoHint { Anchor: (Top: 2); Text: "Requires compatible ammunition."; Style: (...$C.@DefaultLabelStyle, FontSize: 8, Wrap: true, TextColor: @Muted); }
            }
          }
        }
        Group #StatsStrip { LayoutMode: Left; FlexWeight: 1;
          @StatCell #HealthStat { @Label = "HEALTH"; @Accent = #e76f6f; }
          @StatCell #StaminaStat { @Label = "STAMINA"; @Accent = #e7c45e; }
          @StatCell #ManaStat { @Label = "MANA"; @Accent = #66a8df; }
          @StatCell #DefenseStat { @Label = "DEFENSE"; @Accent = #a8bbc9; }
        }
      }

      Group #ProfileAssetsPanel {
        LayoutMode: Top;
        FlexWeight: 1;
        Anchor: (Left: @HalfGap);
        Background: @PanelBackground;
        Padding: (Full: @Padding);
        Label #ProfilePanelTitle { Anchor: (Height: 30, Bottom: 6); Text: "NPC PROFILE"; Style: (...$C.@DefaultLabelStyle, FontSize: 17, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
        Group #ProfileSummary { LayoutMode: Top; Anchor: (Height: 122, Bottom: 6); Background: #101a24; Padding: (Full: 9);
          Group { LayoutMode: Left; Anchor: (Height: 24); Label { Anchor: (Width: 86); Text: "NAME"; Style: (...$C.@DefaultLabelStyle, FontSize: 9, RenderBold: true, TextColor: @Gold, VerticalAlignment: Center); } Label #ProfileNameValue { FlexWeight: 1; Text: "NPC"; Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, VerticalAlignment: Center); } }
          Group { LayoutMode: Left; Anchor: (Height: 22); Label { Anchor: (Width: 86); Text: "ROLE"; Style: (...$C.@DefaultLabelStyle, FontSize: 9, RenderBold: true, TextColor: @Gold, VerticalAlignment: Center); } Label #ProfileRoleValue { FlexWeight: 1; Text: "Unassigned"; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } }
          Label #ProfileBiographyValue { Anchor: (Height: 46, Top: 4); Text: "Biography not authored yet."; Style: (...$C.@DefaultLabelStyle, FontSize: 10, Wrap: true, TextColor: #b8c7d4); }
          Label #ProfileReadinessValue { Anchor: (Height: 18); Text: "PROFILE STATUS"; Style: (...$C.@DefaultLabelStyle, FontSize: 9, RenderBold: true, TextColor: #d0a65a); }
        }
        Group #EditorButtons { LayoutMode: Left; Anchor: (Height: 36, Bottom: 6);
          $C.@TextButton #ProfileEditorButton { @Anchor = (Right: 4); Text: "Profile Editor"; FlexWeight: 1; }
          $C.@SecondaryTextButton #AppearanceEditorButton { @Anchor = (Left: 4, Right: 4); Text: "NPC Appearance"; FlexWeight: 1; }
          $C.@SecondaryTextButton #VoiceRecorderButton { @Anchor = (Left: 4); Text: "Voice Recorder"; FlexWeight: 1; }
        }
        Group #AdvancedFileControls { LayoutMode: Left; Anchor: (Height: 28, Bottom: 6);
          Label { Anchor: (Width: 76); Text: "ADVANCED"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, RenderBold: true, TextColor: #75899a, VerticalAlignment: Center); }
          Label #PROFILEFilename { FlexWeight: 1; Text: "Not selected"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, TextColor: #8ea2b2, VerticalAlignment: Center); }
          $C.@SecondaryTextButton #PROFILEOpen { @Anchor = (Width: 64, Right: 4); Text: "Profile"; }
          Label #SKINFilename { Visible: false; Text: "Not selected"; }
          $C.@SecondaryTextButton #SKINOpen { @Anchor = (Width: 54); Text: "Skin"; }
        }
        Group #VoiceSummary { LayoutMode: Top; FlexWeight: 1;
          Label #VoiceReadyText { Anchor: (Height: 18, Bottom: 3); Text: "VOICE: NOT READY"; Style: (...$C.@DefaultLabelStyle, FontSize: 9, RenderBold: true, TextColor: #e76f6f); }
          @VoiceSummaryRow #VoiceREFERENCE { @Sample = "Reference"; }
          @VoiceSummaryRow #VoiceAFFECTIONATE { @Sample = "Affectionate"; }
          @VoiceSummaryRow #VoiceAMUSED { @Sample = "Amused"; }
          @VoiceSummaryRow #VoiceEXCITED { @Sample = "Excited"; }
          @VoiceSummaryRow #VoiceANGRY { @Sample = "Angry"; }
          @VoiceSummaryRow #VoiceSAD { @Sample = "Sad"; }
          @VoiceSummaryRow #VoiceSCARED { @Sample = "Scared"; }
          $C.@SecondaryTextButton #VoiceRescanButton { @Anchor = (Top: 3, Height: 24); Text: "Rescan"; }
        }
      }
    }

    Group #InventoriesPanel {
      LayoutMode: Top;
      Anchor: (Height: 350, Bottom: 8);
      Background: @PanelBackground;
      Padding: (Full: @Padding);
      Label { Anchor: (Height: 28, Bottom: 4); Text: "COUPLED INVENTORIES"; Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
      Group { LayoutMode: Left; FlexWeight: 1;
        Group #NpcInventoryPanel { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 4);
          Label #NpcInventoryTitle { Anchor: (Height: 24, Bottom: 2); Text: "NPC INVENTORY"; Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: @Gold, HorizontalAlignment: Center); }
          Group #NpcGridHost { LayoutMode: Center; FlexWeight: 1; Background: #101a24; }
        }
        Group #TransferRail { LayoutMode: CenterMiddle; Anchor: (Width: 58, Left: 4, Right: 4); Background: #101a24;
          Label { Text: "↔"; Style: (...$C.@DefaultLabelStyle, FontSize: 24, RenderBold: true, TextColor: #6f879a, HorizontalAlignment: Center, VerticalAlignment: Center); }
        }
        Group #PlayerInventoryPanel { LayoutMode: Top; FlexWeight: 1; Anchor: (Left: 4);
          Label #PlayerInventoryTitle { Anchor: (Height: 24, Bottom: 2); Text: "PLAYER STORAGE"; Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: @Cyan, HorizontalAlignment: Center); }
          Group #PlayerGridHost { LayoutMode: Center; FlexWeight: 1; Background: #101a24; }
        }
      }
    }

    Label #StatusText { Anchor: (Height: 24, Bottom: 6); Visible: false; Text: ""; Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 11, HorizontalAlignment: Center); }
    Group #WorkspaceFooter { LayoutMode: Left; Anchor: (Height: 38);
      $C.@SecondaryTextButton #CancelButton { @Sounds = $Sounds.@ButtonsCancel; @Anchor = (Right: 5); Text: "Cancel"; FlexWeight: 1; }
      Button #DeleteButton { Anchor: (Width: 240, Left: 5, Right: 5); Background: #8f3038; Label { Text: "DELETE"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      $C.@TextButton #EnterButton { @Sounds = $Sounds.@SaveSettings; @Anchor = (Left: 5); Text: "Enter"; FlexWeight: 1; }
    }
  }
}

$C.@PageOverlay #ContextEditorPage {
  LayoutMode: Middle;
  Visible: false;
  Group { Anchor: (Width: 760, Height: 360); LayoutMode: Top; Background: @PanelBackground; Padding: (Full: 18);
    Label #ContextEditorTitle { Anchor: (Height: 42, Bottom: 16); Text: "CONTEXTUAL EDITOR"; Style: (...$C.@DefaultLabelStyle, FontSize: 22, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
    Group { FlexWeight: 1; LayoutMode: CenterMiddle; Background: #101a24; Padding: (Full: 24); Label #ContextEditorStatus { Text: "Editor stage is not active yet."; Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: #aebdcb, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    $C.@SecondaryTextButton #ContextCloseButton { @Sounds = $Sounds.@ButtonsCancel; @Anchor = (Top: 16, Height: 40); Text: "Return to Studio"; }
  }
}

$C.@PageOverlay #ProfileEditorPage {
  LayoutMode: Middle;
  Visible: false;
  Group { Anchor: (Width: 1520, Height: 960); LayoutMode: Top; Background: @PanelBackground; Padding: (Full: 18);
    Group { Anchor: (Height: 42, Bottom: 10); LayoutMode: Left;
      Label { Text: "PROFILE EDITOR"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 22, RenderBold: true, TextColor: #f1f5f9, VerticalAlignment: Center); }
      Label #ProfileDraftMeta { Anchor: (Width: 760); Text: "Draft"; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #6f879a, HorizontalAlignment: End, VerticalAlignment: Center); }
    }
    Group { LayoutMode: Left; FlexWeight: 1;
      Group { Anchor: (Width: 210, Right: 10); LayoutMode: Top; Background: #101a24; Padding: (Full: 12);
        Label { Anchor: (Height: 28); Text: "CATEGORIES"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Gold); }
        Label { Anchor: (Height: 30); Text: "Identity"; Style: (...$C.@DefaultLabelStyle, TextColor: #dce8f3); }
        Label { Anchor: (Height: 30); Text: "Personality"; Style: (...$C.@DefaultLabelStyle, TextColor: #dce8f3); }
        Label { Anchor: (Height: 30); Text: "Biography"; Style: (...$C.@DefaultLabelStyle, TextColor: #dce8f3); }
        Label { Anchor: (Height: 30); Text: "Motivations"; Style: (...$C.@DefaultLabelStyle, TextColor: #dce8f3); }
        Label { Anchor: (Height: 30); Text: "Behavior & Speech"; Style: (...$C.@DefaultLabelStyle, TextColor: #dce8f3); }
        Label { Anchor: (Height: 30); Text: "Relationships (read-only)"; Style: (...$C.@DefaultLabelStyle, TextColor: #6f879a); }
        Label { Anchor: (Height: 30); Text: "Advanced"; Style: (...$C.@DefaultLabelStyle, TextColor: #6f879a); }
        Group { FlexWeight: 1; }
        Label #ProfileStableIdentity { Anchor: (Height: 70); Text: "Stable ID"; Style: (...$C.@DefaultLabelStyle, FontSize: 10, Wrap: true, TextColor: #6f879a); }
      }
      Group { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1; Background: #101a24; Padding: (Full: 14);
        Label { Anchor: (Height: 26); Text: "IDENTITY"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Gold); }
        Label #ProfileDisplayName { Anchor: (Height: 24); Text: "Display name (identity-safe, read-only)"; Style: (...$C.@DefaultLabelStyle, TextColor: #aebdcb); }
        $C.@TextField #ProfileRoleInput { @Anchor = (Height: 38, Bottom: 8); PlaceholderText: "Role"; MaxLength: 160; }
        $C.@TextField #ProfileSelfIdentityInput { @Anchor = (Height: 38, Bottom: 8); PlaceholderText: "Self identity"; MaxLength: 400; }
        Group { LayoutMode: Left; Anchor: (Height: 38, Bottom: 12);
          $C.@TextField #ProfileSpeciesInput { @Anchor = (Right: 4); PlaceholderText: "Species archetype"; MaxLength: 80; FlexWeight: 1; }
          $C.@TextField #ProfileAgeInput { @Anchor = (Left: 4); PlaceholderText: "Age category"; MaxLength: 40; FlexWeight: 1; }
        }
        Group { LayoutMode: Left; Anchor: (Height: 38, Bottom: 12);
          $C.@TextField #ProfileHomeInput { @Anchor = (Right: 4); PlaceholderText: "Home"; MaxLength: 200; FlexWeight: 1; }
          $C.@TextField #ProfileWorkplaceInput { @Anchor = (Left: 4); PlaceholderText: "Workplace"; MaxLength: 200; FlexWeight: 1; }
        }
        Label { Anchor: (Height: 26); Text: "PERSONALITY"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Gold); }
        MultilineTextField #ProfilePersonalityInput { Anchor: (Height: 92, Bottom: 8); Background: $C.@InputBoxBackground; MaxVisibleLines: 5; AutoGrow: false; MaxLength: 900; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; PlaceholderText: "Personality summary"; }
        $C.@TextField #ProfileTraitsInput { @Anchor = (Height: 38, Bottom: 8); PlaceholderText: "Traits (comma or line separated)"; MaxLength: 700; }
        $C.@TextField #ProfileValuesInput { @Anchor = (Height: 38, Bottom: 8); PlaceholderText: "Values (comma or line separated)"; MaxLength: 700; }
        Group { LayoutMode: Left; Anchor: (Height: 38, Bottom: 12);
          $C.@TextField #ProfileLikesInput { @Anchor = (Right: 4); PlaceholderText: "Likes"; MaxLength: 700; FlexWeight: 1; }
          $C.@TextField #ProfileDislikesInput { @Anchor = (Left: 4); PlaceholderText: "Dislikes"; MaxLength: 700; FlexWeight: 1; }
        }
        $C.@TextField #ProfileFearsInput { @Anchor = (Height: 38, Bottom: 12); PlaceholderText: "Fears"; MaxLength: 700; }
        Label { Anchor: (Height: 26); Text: "BIOGRAPHY"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Gold); }
        MultilineTextField #ProfileBiographyInput { Anchor: (Height: 130, Bottom: 12); Background: $C.@InputBoxBackground; MaxVisibleLines: 7; AutoGrow: false; MaxLength: 1800; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; PlaceholderText: "Biography"; }
        Label { Anchor: (Height: 26); Text: "MOTIVATIONS"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Gold); }
        MultilineTextField #ProfilePurposeInput { Anchor: (Height: 82, Bottom: 8); Background: $C.@InputBoxBackground; MaxVisibleLines: 4; AutoGrow: false; MaxLength: 900; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; PlaceholderText: "Purpose"; }
        $C.@TextField #ProfileGoalsInput { @Anchor = (Height: 38, Bottom: 12); PlaceholderText: "Goals (comma or line separated)"; MaxLength: 900; }
        Label { Anchor: (Height: 26); Text: "BEHAVIOR & SPEECH"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Gold); }
        MultilineTextField #ProfileSpeakingInput { Anchor: (Height: 82, Bottom: 8); Background: $C.@InputBoxBackground; MaxVisibleLines: 4; AutoGrow: false; MaxLength: 900; ContentPadding: (Horizontal: 10, Vertical: 8); Style: $C.@DefaultInputFieldStyle; PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle; PlaceholderText: "Speech and mannerisms"; }
        $C.@TextField #ProfileKnowledgeInput { @Anchor = (Height: 38, Bottom: 8); PlaceholderText: "Knowledge domains"; MaxLength: 900; }
        Label #ProfileRelationshipsSummary { Anchor: (Height: 42, Bottom: 8); Text: "Relationships are managed by their authoritative subsystem."; Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #6f879a); }
      }
      Group { Anchor: (Width: 330, Left: 10); LayoutMode: Top; Background: #101a24; Padding: (Full: 12);
        Label { Anchor: (Height: 28); Text: "GENERATE PROPOSAL"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: @Cyan); }
        Label { Anchor: (Height: 54); Text: "Low-priority and proposal-only. Nothing becomes canon until reviewed and saved."; Style: (...$C.@DefaultLabelStyle, FontSize: 11, Wrap: true, TextColor: #aebdcb); }
        $C.@TextField #ProfileGenerateScopeInput { @Anchor = (Height: 38, Bottom: 8); PlaceholderText: "BIOGRAPHY / PERSONALITY_VALUES / ..."; MaxLength: 40; }
        Label #ProfileGenerationStatus { Anchor: (Height: 64, Bottom: 8); Text: "Choose a scope."; Style: (...$C.@DefaultLabelStyle, FontSize: 11, Wrap: true, TextColor: #aebdcb); }
        Group #ProfileProposalPanel { Visible: false; LayoutMode: Top; FlexWeight: 1; Background: #142331; Padding: (Full: 8);
          Label { Anchor: (Height: 24); Text: "FIELD-LEVEL DIFF"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #9ed7a6); }
          Label #ProfileProposalDiff { FlexWeight: 1; Text: ""; Style: (...$C.@DefaultLabelStyle, FontSize: 11, Wrap: true, TextColor: #dce8f3); }
          $C.@TextField #ProfileProposalSelectionInput { @Anchor = (Height: 34, Top: 6); PlaceholderText: "Optional fields: BIOGRAPHY, GOALS"; MaxLength: 240; }
          Group { LayoutMode: Left; Anchor: (Height: 38, Top: 8);
            $C.@TextButton #ProfileAcceptProposalButton { @Anchor = (Right: 4); Text: "Accept All"; FlexWeight: 1; }
            $C.@TextButton #ProfileAcceptSelectedProposalButton { @Anchor = (Left: 4, Right: 4); Text: "Accept Selected"; FlexWeight: 1; }
            $C.@SecondaryTextButton #ProfileDiscardProposalButton { @Anchor = (Left: 4); Text: "Discard"; FlexWeight: 1; }
          }
        }
      }
    }
    Label #ProfileValidationStatus { Anchor: (Height: 30, Top: 8); Text: "Draft valid"; Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #9ed7a6, HorizontalAlignment: Center); }
    Group { LayoutMode: Left; Anchor: (Height: 42, Top: 8);
      $C.@TextButton #ProfileGenerateButton { @Anchor = (Right: 5); Text: "Generate"; FlexWeight: 1; }
      $C.@SecondaryTextButton #ProfileResetButton { @Anchor = (Left: 5, Right: 5); Text: "Reset"; FlexWeight: 1; }
      $C.@SecondaryTextButton #ProfileCancelButton { @Sounds = $Sounds.@ButtonsCancel; @Anchor = (Left: 5, Right: 5); Text: "Cancel"; FlexWeight: 1; }
      $C.@TextButton #ProfileSaveButton { @Sounds = $Sounds.@SaveSettings; @Anchor = (Left: 5); Text: "Save Profile"; FlexWeight: 1; }
    }
  }
}

