$C.@PageOverlay #VoiceRecorderPage {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 520, Height: 720);
    #Title { $C.@Title #VoiceRecorderTitle { @Text = "VOICE RECORDER"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 9);
      Group { FlexWeight: 1; LayoutMode: Top; Background: #09141e; Padding: (Full: 12);
        Label #VoiceRecorderMeta { Visible: false; Text: "PRIVATE CREATOR-ONLY CAPTURE"; }
        Group { Anchor: (Height: 250, Bottom: 10); LayoutMode: Top; Background: @RecorderSurface; Padding: (Full: 9);
          Label { Anchor: (Height: 20, Bottom: 6); Text: "SELECT EMOTION"; Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #aebdcb); }
          Button #VoiceEmotionREFERENCE { Anchor: (Height: 28, Bottom: 2); LayoutMode: Left; Background: @RecorderRow; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Reference"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, RenderBold: true, VerticalAlignment: Center); } Label #VoiceSavedREFERENCE { Anchor: (Width: 68); Text: "REQUIRED"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedREFERENCE {} }
          Button #VoiceEmotionAFFECTIONATE { Anchor: (Height: 28, Bottom: 2); LayoutMode: Left; Background: @RecorderSurface; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Affectionate"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } Label #VoiceSavedAFFECTIONATE { Anchor: (Width: 68); Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedAFFECTIONATE { @Visible = false; } }
          Button #VoiceEmotionAMUSED { Anchor: (Height: 28, Bottom: 2); LayoutMode: Left; Background: @RecorderSurface; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Amused"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } Label #VoiceSavedAMUSED { Anchor: (Width: 68); Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedAMUSED { @Visible = false; } }
          Button #VoiceEmotionEXCITED { Anchor: (Height: 28, Bottom: 2); LayoutMode: Left; Background: @RecorderSurface; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Excited"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } Label #VoiceSavedEXCITED { Anchor: (Width: 68); Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedEXCITED { @Visible = false; } }
          Button #VoiceEmotionANGRY { Anchor: (Height: 28, Bottom: 2); LayoutMode: Left; Background: @RecorderSurface; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Angry"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } Label #VoiceSavedANGRY { Anchor: (Width: 68); Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedANGRY { @Visible = false; } }
          Button #VoiceEmotionSAD { Anchor: (Height: 28, Bottom: 2); LayoutMode: Left; Background: @RecorderSurface; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Sad"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } Label #VoiceSavedSAD { Anchor: (Width: 68); Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedSAD { @Visible = false; } }
          Button #VoiceEmotionSCARED { Anchor: (Height: 28); LayoutMode: Left; Background: @RecorderSurface; Group { Anchor: (Width: 18); LayoutMode: CenterMiddle; Group { Anchor: (Width: 6, Height: 6); Background: #526b7f; } } Label { Text: "Scared"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, VerticalAlignment: Center); } Label #VoiceSavedSCARED { Anchor: (Width: 68); Text: "—"; Style: (...$C.@DefaultLabelStyle, FontSize: 8, HorizontalAlignment: Center, VerticalAlignment: Center); } @VoiceSelectionMarker #VoiceSelectedSCARED { @Visible = false; } }
        }
        Group { LayoutMode: Left; Anchor: (Height: 30, Bottom: 5); Padding: (Horizontal: 4); Label #VoiceSelectedEmotion { Text: "REFERENCE"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: @Gold, VerticalAlignment: Center); } Label #VoiceRecordingIndicator { Visible: false; Anchor: (Width: 94); Text: "● RECORDING"; Style: (...$C.@DefaultLabelStyle, FontSize: 9, RenderBold: true, TextColor: #ed6670, HorizontalAlignment: Center, VerticalAlignment: Center); } Label #VoiceElapsed { Anchor: (Width: 112); Text: "00:00 / 00:30"; Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #d7e4ee, HorizontalAlignment: End, VerticalAlignment: Center); } }
