          Button #VoiceDeleteButton { Anchor: (Left: 4); FlexWeight: 1; LayoutMode: Left; Style: $C.@CancelButtonStyle; Group { Anchor: (Width: 24, Height: 24, Left: 12); Background: "ImmersiveNpcInventory/NpcIconDelete.png"; } Label { Text: "DELETE"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 11, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
        }
        Button #VoiceSaveButton { Anchor: (Height: 44, Bottom: 10); LayoutMode: Left; Style: $C.@DefaultButtonStyle; Group { Anchor: (Width: 24, Height: 24, Left: 146); Background: "ImmersiveNpcInventory/NpcIconSelectSample.png"; } Label { Text: "SAVE SAMPLE"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
        Label { Anchor: (Height: 24); Text: "Format: WAV   •   16bit   •   48kHz"; Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #91a6b7, HorizontalAlignment: Center, VerticalAlignment: Center); }
        Label #VoiceRecorderState { Visible: false; Text: "IDLE"; }
        Label #VoiceQualityMetrics { Visible: false; Text: ""; Style: (...$C.@DefaultLabelStyle); }
        Label #VoiceRecorderStatus { Visible: false; Text: ""; Style: (...$C.@DefaultLabelStyle); }
        Label #VoiceProfileReadiness { Visible: false; Text: ""; Style: (...$C.@DefaultLabelStyle); }
      }
    }
  }
}

$C.@PageOverlay #VoiceDeleteConfirmPage {
  LayoutMode: Middle;
  Visible: false;
  Group { Anchor: (Width: 620, Height: 260); LayoutMode: Top; Background: @PanelBackground; Padding: (Full: 20);
    Label { Anchor: (Height: 36); Text: "DELETE SAVED VOICE SAMPLE?"; Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
    Label #VoiceDeleteWarning { Anchor: (Height: 105, Bottom: 18); Text: "This moves the saved sample to recoverable trash."; Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: #e76f6f, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Group { LayoutMode: Left; Anchor: (Height: 44); $C.@SecondaryTextButton #VoiceDeleteSavedCancelButton { @Anchor = (Right: 6); Text: "Cancel"; FlexWeight: 1; } Button #VoiceDeleteSavedConfirmButton { Anchor: (Left: 6); FlexWeight: 1; Background: #8f3038; Label { Text: "DELETE SAMPLE"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
  }
}

$C.@PageOverlay #DirtyEditorConfirmPage {
  LayoutMode: Middle;
  Visible: false;
  Group { Anchor: (Width: 580, Height: 250); LayoutMode: Top; Background: @PanelBackground; Padding: (Full: 20);
    Label { Anchor: (Height: 34); Text: "UNSAVED EDITOR CHANGES"; Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
    Label { Anchor: (Height: 92, Bottom: 18); Text: "Save this draft, discard it, or stay in the current editor?"; Style: (...$C.@DefaultLabelStyle, FontSize: 15, Wrap: true, TextColor: #aebdcb, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Group { LayoutMode: Left; Anchor: (Height: 42);
      $C.@TextButton #DirtySaveButton { @Sounds = $Sounds.@SaveSettings; @Anchor = (Right: 5); Text: "Save"; FlexWeight: 1; }
      Button #DirtyDiscardButton { Anchor: (Left: 5, Right: 5); FlexWeight: 1; Background: #8f3038; Label { Text: "DISCARD"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      $C.@SecondaryTextButton #DirtyStayButton { @Sounds = $Sounds.@ButtonsCancel; @Anchor = (Left: 5); Text: "Stay"; FlexWeight: 1; }
    }
  }
}

$C.@PageOverlay #DeleteConfirmPage {
  LayoutMode: Middle;
  Visible: false;
  Group { Anchor: (Width: 560, Height: 230); LayoutMode: Top; Background: @PanelBackground; Padding: (Full: 20);
    Label { Anchor: (Height: 34); Text: "ARE YOU SURE?"; Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
    Label #DeleteConfirmName { Anchor: (Height: 80, Bottom: 18); Text: "Delete NPC?"; Style: (...$C.@DefaultLabelStyle, FontSize: 22, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Group { LayoutMode: Left; Anchor: (Height: 42);
      $C.@SecondaryTextButton #DeleteNoButton { @Sounds = $Sounds.@ButtonsCancel; @Anchor = (Right: 6); Text: "No"; FlexWeight: 1; }
      Button #DeleteYesButton { Anchor: (Left: 6); FlexWeight: 1; Background: #8f3038; Label { Text: "YES"; Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }
  }
}

$C.@PageOverlay #BrowserPage {
  LayoutMode: Middle;
  Visible: false;
  Group { Anchor: (Width: 650, Height: 610); LayoutMode: Top; Background: @PanelBackground; Padding: (Full: 16);
    Label #BrowserTitle { Anchor: (Height: 38); Text: "Select File"; Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f1f5f9, HorizontalAlignment: Center); }
    Label #CurrentPath { Anchor: (Bottom: 8); Text: "/"; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #6a7d8f); }
    $C.@TextField #SearchInput { @Anchor = (Left: 0, Bottom: 10); PlaceholderText: "Search files"; }
    Group #FileList { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; }
    $C.@SecondaryTextButton #BrowserCancelButton { @Sounds = $Sounds.@ButtonsCancel; @Anchor = (Top: 12, Height: 38); Text: "Cancel"; }
  }
}

Group #AuthoringBackNavigation {
  LayoutMode: Left;
  Anchor: (Left: 50, Bottom: 50, Width: 110, Height: 27);
  BackButton #AuthoringBackButton {}
}
