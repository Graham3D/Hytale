  "required": ["schemaVersion", "id", "productionInput", "originalModelOutput", "claimFirewallOutcome", "eligibility", "eligibilityEvidence", "provenance", "state", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
