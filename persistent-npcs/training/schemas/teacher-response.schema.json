{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inigmasgames.local/orbis/teacher-response.schema.json",
  "title": "Orbis Teacher Response Without Hidden Reasoning",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "finalAnswer", "critique", "scores", "rationaleSummary", "evidenceRefs", "confidence", "refusal"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1},
    "finalAnswer": {"type": "string"},
    "critique": {"type": "string"},
    "scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "rationaleSummary": {"type": "string"},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "refusal": {"type": "boolean"}
  }
}
