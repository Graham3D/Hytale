{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inigmasgames.local/orbis/teacher-source-policy.schema.json",
  "title": "Orbis Teacher Source Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "sourceId", "status", "termsVersion", "allowedUses", "prohibitedUses", "reviewedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "policyId": {"type": "string", "minLength": 1},
    "sourceId": {"type": "string", "minLength": 1},
    "status": {"enum": ["APPROVED", "REJECTED", "UNKNOWN"]},
    "termsVersion": {"type": "string", "minLength": 1},
    "licenseId": {"type": "string"},
    "allowedUses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prohibitedUses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decisionBasis": {"type": "string"},
    "reviewedAt": {"type": "string", "format": "date-time"}
  }
}
