Group {
  Anchor: (Full: 0);
  // The native page owns typing, but retains the exact editor composition beneath these controls.
  Button #GraphSearchOutside {
    Anchor: (Full: 0);
    Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #00000000), Pressed: (Background: #00000000));
  }
  Group #GraphSearchFocus { Anchor: (Left: 125, Top: 181, Width: 230, Height: 40); Background: (Color: #78c6d0ff); }
  Group { Anchor: (Left: 127, Top: 183, Width: 226, Height: 36); Background: (Color: #202b42ff); }
  Group { Anchor: (Left: 126, Top: 182, Width: 228, Height: 38); Background: (Color: #00000000);
    TextField #GraphSearchInput {
      Anchor: (Left: 0, Top: 0, Width: 194, Height: 38);
      Background: (Color: #00000000);
      Padding: (Horizontal: 6, Vertical: 8);
      Style: (FontSize: 11, TextColor: #b9cce0);
      PlaceholderStyle: (FontSize: 11, TextColor: #b9cce0);
      PlaceholderText: "Search skills...";
    }
  }
  Button #GraphSearchClose {
    Anchor: (Left: 324, Top: 186, Width: 26, Height: 30);
    Style: ButtonStyle(Default: (Background: #29455cff), Hovered: (Background: #3d607aff), Pressed: (Background: #1d3448ff));
  }
  Label { Text: "X"; Anchor: (Left: 324, Top: 191, Width: 26, Height: 20); Style: (FontSize: 12, TextColor: #eef6ff, HorizontalAlignment: Center, VerticalAlignment: Center); }
  Button #GraphSearchResult0 { Visible: false; Anchor: (Left: 122, Top: 222, Width: 218, Height: 39); Style: ButtonStyle(Default: (Background: #00000000), Hovered: (Background: #78c6d022), Pressed: (Background: #78c6d044)); }
