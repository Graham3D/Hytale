        Label #GraphContextNoLabel { Text: "No"; Anchor: (Left: 120, Top: 56, Width: 60, Height: 18); Style: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center); }
      }
    }
    Label #GraphEditorSaved { Visible: false; Text: "SAVED"; Anchor: (Width: 320, Height: 54); Style: (FontName: "Secondary", FontSize: 26, RenderBold: true, TextColor: #65e884ff, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Label #GraphEditorDrag { Text: "Drag a Skill or Passive from the Library on the left onto a matching empty slot. Drag a connector from one node port to another compatible node to create a link, pairing a Passive to Skill."; Anchor: (Left: 300, Right: 300, Bottom: 62, Height: 34); Style: (FontSize: 10, TextColor: #f2d488, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true); }
    Group #GraphEditorReset { Anchor: (Left: 90, Bottom: 24, Width: 120, Height: 44); Background: (TexturePath: "Assets/SkillTree/Hytale/Buttons/Destructive.png", Border: 8); }
    Label #GraphEditorResetLabel { Text: "RESET"; Anchor: (Left: 90, Bottom: 35, Width: 120, Height: 22); Style: (FontSize: 13, TextColor: #d3d6db, HorizontalAlignment: Center); }
    Group #GraphEditorSave { Anchor: (Right: 154, Bottom: 24, Width: 120, Height: 44); Background: (TexturePath: "Assets/SkillTree/Hytale/Buttons/Primary.png", VerticalBorder: 8, HorizontalBorder: 40); }
    Label #GraphEditorSaveLabel { Text: "SAVE"; Anchor: (Right: 154, Bottom: 35, Width: 120, Height: 22); Style: (FontSize: 13, TextColor: #d3d6db, HorizontalAlignment: Center); }
    Group #GraphEditorExit { Anchor: (Right: 24, Bottom: 24, Width: 120, Height: 44); Background: (TexturePath: "Assets/SkillTree/Hytale/Buttons/Destructive.png", Border: 8); }
    Label #GraphEditorExitLabel { Text: "EXIT"; Anchor: (Right: 24, Bottom: 35, Width: 120, Height: 22); Style: (FontSize: 13, TextColor: #d3d6db, HorizontalAlignment: Center); }
  }
}
