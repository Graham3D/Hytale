Group {
  Anchor: (Full: 0);
  Group #GraphWorldScrim { Anchor: (Full: 0); Background: (Color: #02091399); }
  Group #GraphEditorSurface {
    Anchor: (Left: 90, Right: 90, Top: 50, Bottom: 50);
    Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerFullPatch@2x.png", Border: 23);
    Group { Anchor: (Left: 12, Right: 12, Top: 10, Height: 76); Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerHeader@2x.png", HorizontalBorder: 50, VerticalBorder: 0); }
    Group { Anchor: (Horizontal: 236, Top: 4, Height: 11); Background: "Assets/SkillTree/Hytale/ContainerDecorationTop@2x.png"; }
    Group { Anchor: (Horizontal: 236, Bottom: 4, Height: 11); Background: "Assets/SkillTree/Hytale/ContainerDecorationBottom@2x.png"; }
    Label #GraphEditorBrand { Text: "HYWIND RPG"; Anchor: (Left: 28, Top: 24, Width: 250, Height: 28); Style: (FontSize: 19, TextColor: #78c6d0); }
    Label #GraphEditorTitle { Text: "SKILL TREE"; Anchor: (Horizontal: 300, Top: 8, Height: 30); Style: (FontSize: 22, TextColor: #f2d488, HorizontalAlignment: Center); }
    Label #GraphEditorSubtitle { Text: "SHAPE YOUR JOURNEY"; Anchor: (Horizontal: 300, Top: 38, Height: 20); Style: (FontSize: 10, TextColor: #b9cce0, HorizontalAlignment: Center); }
    Label #GraphEditorRevision { Text: "REV"; Anchor: (Right: 28, Top: 24, Width: 90, Height: 26); Style: (FontSize: 13, TextColor: #f2d488, HorizontalAlignment: End); }

    Group #GraphWorkspace { Anchor: (Left: 24, Right: 24, Top: 90, Bottom: 94); Background: (Color: #020a1200);
