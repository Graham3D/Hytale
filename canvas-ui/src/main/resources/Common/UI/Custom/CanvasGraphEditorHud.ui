@GraphEditorTitleStyle = LabelStyle(
  FontSize: 19,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #ffffffff,
  FontName: "Secondary",
  RenderBold: true,
  ShrinkTextToFit: true,
  MinShrinkTextToFitFontSize: 15,
  LetterSpacing: 0
);

Group {
  Anchor: (Full: 0);
  Group #GraphWorldScrim { Anchor: (Full: 0); Background: (Color: #02091399); }
  Group #GraphEditorSurface {
    Anchor: (Left: 90, Right: 90, Top: 50, Bottom: 50);
    Background: (Color: #020a1200);
    Group #GraphEditorPrimaryFrame { Anchor: (Full: 0); Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerFullPatch.png", Border: 23); }
    Group #GraphEditorPrimaryHeader { Anchor: (Left: 18, Right: 18, Top: 18, Height: 46); Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerPanelLightPatch.png", Border: 6); }
    Group { Anchor: (Width: 236, Top: 4, Height: 11); Background: "Assets/SkillTree/Hytale/ContainerDecorationTop.png"; }
    Group { Anchor: (Width: 236, Bottom: 4, Height: 11); Background: "Assets/SkillTree/Hytale/ContainerDecorationBottom.png"; }
    Group #GraphEditorTitleSelection { Anchor: (Width: 220, Top: 8, Height: 62); Background: (TexturePath: "Assets/SkillTree/Hytale/TabSelectedOverlay.png", Border: 3); }
    Label #GraphEditorTitle { Text: "SKILL TREE"; Anchor: (Left: 18, Right: 18, Top: 16, Height: 46); MaskTexturePath: "Assets/SkillTree/Hytale/TextGradient.png"; Style: (...@GraphEditorTitleStyle, HorizontalAlignment: Center); }

    Group #GraphWorkspace { Anchor: (Left: 24, Right: 24, Top: 78, Bottom: 94); Background: (Color: #020a1200);
      Group #GraphLibraryFrame { Anchor: (Left: 0, Top: 0, Width: 252, Bottom: 0); Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerFullPatch.png", Border: 23); }
      Group #GraphTreeFrame { Anchor: (Left: 260, Right: 260, Top: 0, Bottom: 0); Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerFullPatch.png", Border: 23); }
      Group #GraphTreeFill { Anchor: (Left: 272, Right: 272, Top: 12, Bottom: 12); Background: (TexturePath: "Assets/SkillTree/Hytale/ContainerPanelPatch.png", Border: 6); }
      Group #GraphTreeBackground { Anchor: (Left: 272, Right: 272, Top: 12, Bottom: 12); Background: (TexturePath: "Assets/SkillTree/Hytale/DiagramCraftingBackground.png", Border: 82); }
      Group #GraphEditorSkillsTab { Anchor: (Left: 12, Top: 14, Width: 108, Height: 34); Background: (TexturePath: "Assets/SkillTree/Hytale/HeaderTabSelectedBackground.png", Border: 9); }
      Label #GraphEditorSkillsTabLabel { Text: "SKILLS"; Anchor: (Left: 12, Top: 14, Width: 108, Height: 34); Style: (FontSize: 12, TextColor: #ffe682, HorizontalAlignment: Center, VerticalAlignment: Center); }
      Group #GraphEditorPassivesTab { Anchor: (Left: 124, Top: 14, Width: 116, Height: 34); Background: (TexturePath: "Assets/SkillTree/Hytale/HeaderTabBackground.png", Border: 9); }
      Label #GraphEditorPassivesTabLabel { Text: "PASSIVES"; Anchor: (Left: 124, Top: 14, Width: 116, Height: 34); Style: (FontSize: 12, TextColor: #b4c8c9, HorizontalAlignment: Center, VerticalAlignment: Center); }
      Group { Anchor: (Left: 12, Top: 54, Width: 228, Height: 38); Background: (TexturePath: "Assets/SkillTree/Hytale/InputBox.png", Border: 10); }
      Label #GraphEditorSearch { Text: "Search skills..."; Anchor: (Left: 18, Top: 63, Width: 200, Height: 20); Style: (FontSize: 11, TextColor: #b9cce0); }
      Label #GraphEditorNoMatches { Visible: false; Text: "No matches"; Anchor: (Left: 18, Top: 108, Width: 190, Height: 22); Style: (FontSize: 11, TextColor: #8fa2b4); }
      Group #GraphLibraryRow0 { Anchor: (Left: 8, Top: 94, Width: 218, Height: 39); Background: (Color: #183a56f2);
