Group {
  Anchor: (Full: 0);
  Group #GraphWorldScrim { Anchor: (Full: 0); Background: (Color: #02091399); }
  Group #GraphEditorSurface {
    Anchor: (Left: 90, Right: 90, Top: 50, Bottom: 50);
    Background: (Color: #07111bea);
    Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 70); Background: (Color: #102234f8); }
    Label #GraphEditorBrand { Text: "HYTALE RPG"; Anchor: (Left: 20, Top: 14, Width: 250, Height: 28); Style: (FontSize: 19, TextColor: #78c6d0); }
    Label #GraphEditorTitle { Text: "SKILL TREE"; Anchor: (Horizontal: 300, Top: 8, Height: 30); Style: (FontSize: 22, TextColor: #f2d488, HorizontalAlignment: Center); }
